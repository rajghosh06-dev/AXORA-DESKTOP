<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Axora.Desktop.Controls.DependencyStatusControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <InfoBar
            x:Name="StatusInfoBar"
            IsOpen="True"
            IsClosable="False"
            Margin="0,0,0,8"
            AutomationProperties.Name="Dependency Status Alert">
            <InfoBar.ActionButton>
                <Button
                    x:Name="OpenDownloadManagerButton"
                    Content="Open Download Manager"
                    Click="OpenDownloadManagerButton_Click"
                    AutomationProperties.Name="Open Download Manager"
                    AutomationProperties.AutomationId="OpenDownloadManagerButton"
                    Style="{StaticResource SubtleButtonStyle}"/>
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</UserControl>