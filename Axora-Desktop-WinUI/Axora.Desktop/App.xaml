<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Axora.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:converters="using:Axora.Desktop.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <converters:ScoreToColorBrushConverter x:Key="ScoreToColorBrushConverter" />
            <converters:BudgetToColorBrushConverter x:Key="BudgetToColorBrushConverter" />
            <converters:StrengthToColorBrushConverter x:Key="StrengthToColorBrushConverter" />
            <converters:StrengthToTextConverter x:Key="StrengthToTextConverter" />

            <!-- Global Axora Design Tokens -->
            <ThemeShadow x:Key="Elevation16Shadow" />
            <SolidColorBrush x:Key="AxoraPrimaryBrush" Color="#5B7DE8" />
            <SolidColorBrush x:Key="AxoraAccentBrush" Color="#7B5EA7" />
            <SolidColorBrush x:Key="AxoraSurfaceBrush" Color="#0F0F14" />
            <SolidColorBrush x:Key="AxoraSuccessBrush" Color="#4CAF50" />
            <SolidColorBrush x:Key="AxoraWarningBrush" Color="#FF9800" />
            <SolidColorBrush x:Key="AxoraErrorBrush" Color="#F44336" />

            <!-- Typography scale -->
            <x:Double x:Key="AxoraBodyFontSize">14.0</x:Double>
            <x:Double x:Key="AxoraCaptionFontSize">12.0</x:Double>
            <x:Double x:Key="AxoraTitleFontSize">20.0</x:Double>
            <x:Double x:Key="AxoraDisplayFontSize">28.0</x:Double>

            <FontFamily x:Key="AxoraFontFamily">Segoe UI Variable Display</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
