<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Axora.Desktop.Views.ScholarKitPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Axora.Desktop.Models"
    mc:Ignorable="d"
    x:Name="PageRoot"
    Background="Transparent">

    <Grid Padding="24,0,24,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════ TOP ACTION & STATUS TOOLBAR ══════════════════ -->
        <Border Grid.Row="0" CornerRadius="12" Padding="16,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Subtitle -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="6" Background="#1A5B7DE8">
                        <FontIcon Glyph="&#xE736;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Intelligent OCR, Speech Lab &amp; Offline RAG Research Studio"
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Live Status Banner -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="20" Padding="12,4"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing IsActive="{Binding ViewModel.IsProcessing}" Width="14" Height="14"
                                      Visibility="{Binding ViewModel.IsProcessing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <FontIcon Glyph="&#xE720;" FontSize="12" Foreground="#E53935"
                                  Visibility="{Binding ViewModel.IsDictating, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <FontIcon Glyph="&#xE767;" FontSize="12" Foreground="#4CAF50"
                                  Visibility="{Binding ViewModel.IsSpeaking, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding ViewModel.StatusMessage}" FontSize="11.5"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Action Cluster -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Voice Dictation Toggle -->
                    <ToggleButton IsChecked="{Binding ViewModel.IsDictating, Mode=TwoWay}"
                                  Command="{Binding ViewModel.ToggleVoiceDictationCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE720;" FontSize="12"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Dictate Note" FontSize="11.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Read Aloud Toggle -->
                    <ToggleButton IsChecked="{Binding ViewModel.IsSpeaking, Mode=TwoWay}"
                                  Command="{Binding ViewModel.ToggleReadAloudCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE767;" FontSize="12"/>
                            <TextBlock Text="Read Aloud" FontSize="11.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Push to Flashcard Studio -->
                    <Button Command="{Binding ViewModel.PushToFlashcardsCommand}"
                            Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE82D;" FontSize="12"/>
                            <TextBlock Text="Push to Flashcards" FontSize="11.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Export Dropdown -->
                    <DropDownButton Content="Export">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="Copy Extracted Text" Command="{Binding ViewModel.CopyToClipboardCommand}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Save as PDF Document (.pdf)" Command="{Binding ViewModel.ExportPdfCommand}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Save as Markdown Notes (.md)" Command="{Binding ViewModel.ExportMarkdownCommand}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Save as Plain Text (.txt)" Command="{Binding ViewModel.ExportPlainTextCommand}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C1;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Save as Structured JSON (.json)" Command="{Binding ViewModel.ExportJsonCommand}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE943;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <Button Content="Clear" Command="{Binding ViewModel.ClearResultsCommand}" FontSize="11.5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════ 2-COLUMN SPLIT WORKSPACE ══════════════════ -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: INGESTION, INTELLIGENCE & OCR PIPELINE ── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">

                    <!-- Unified Ingestion Drop Zone -->
                    <Border CornerRadius="12" Padding="16"
                            BorderThickness="1.5"
                            BorderBrush="{ThemeResource AccentControlElevationBorderBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            AllowDrop="True"
                            DragOver="DropZone_DragOver"
                            Drop="DropZone_Drop">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="30"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Drop Document / Image Here"
                                       FontWeight="SemiBold" FontSize="13"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="PDF, PNG, JPG, BMP, TIFF"
                                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"/>

                            <!-- Input Action Grid -->
                            <Grid ColumnSpacing="6" RowSpacing="6" Margin="0,4,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button HorizontalAlignment="Stretch" Click="BrowseImage_Click" Padding="4,6">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xEB9F;" FontSize="11"/>
                                        <TextBlock Text="Image" FontSize="11"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="BrowsePdf_Click" Padding="4,6">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="11"/>
                                        <TextBlock Text="PDF" FontSize="11"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Row="1" HorizontalAlignment="Stretch"
                                        Command="{Binding ViewModel.PasteFromClipboardCommand}" Padding="4,6">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE77F;" FontSize="11"/>
                                        <TextBlock Text="Paste (Ctrl+V)" FontSize="11"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                                        Command="{Binding ViewModel.ScanFromFlatbedScannerCommand}" Padding="4,6">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="11"/>
                                        <TextBlock Text="Scanner" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Sample Loader Button -->
                            <Button HorizontalAlignment="Stretch" Margin="0,2,0,0"
                                    Command="{Binding ViewModel.LoadSampleAcademicPaperCommand}"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="4,5">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE7BE;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Load Sample Academic Paper" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Document Intelligence Summary Card -->
                    <Border CornerRadius="12" Padding="14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Active Document" FontWeight="SemiBold" FontSize="12.5"/>
                                <Border Grid.Column="1" CornerRadius="4" Padding="6,2" Background="#1A5B7DE8">
                                    <TextBlock Text="{Binding ViewModel.DocumentFormatBadge}" FontSize="9.5"
                                               FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding ViewModel.ImportedFileName}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       FontSize="12" TextTrimming="CharacterEllipsis"/>

                            <!-- 3-Pill Metric Bar -->
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border CornerRadius="6" Padding="6,4" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <StackPanel HorizontalAlignment="Center" Spacing="1">
                                        <TextBlock Text="WORDS" FontSize="8.5" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding ViewModel.WordCountText}" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" CornerRadius="6" Padding="6,4" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <StackPanel HorizontalAlignment="Center" Spacing="1">
                                        <TextBlock Text="LINES" FontSize="8.5" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding ViewModel.LineCountText}" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" CornerRadius="6" Padding="6,4" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <StackPanel HorizontalAlignment="Center" Spacing="1">
                                        <TextBlock Text="EST. TIME" FontSize="8.5" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding ViewModel.ReadingTimeText}" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- OCR Engine & Pre-processing Controls -->
                    <Expander Header="OCR Pipeline &amp; Speech Settings"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              IsExpanded="False">
                        <StackPanel Spacing="10" Padding="0,6,0,0">
                            <ComboBox Header="OCR Engine"
                                      SelectedIndex="{Binding ViewModel.SelectedEngineIndex, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" FontSize="11.5">
                                <ComboBoxItem Content="WinRT Native OCR (Windows 11 Hardware)"/>
                                <ComboBoxItem Content="DirectML Vision &amp; Layout Parser (NPU/GPU)"/>
                            </ComboBox>

                            <Grid ColumnSpacing="8" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <CheckBox Content="Auto-Deskew" IsChecked="{Binding ViewModel.AutoDeskew, Mode=TwoWay}" FontSize="11"/>
                                <CheckBox Grid.Column="1" Content="Binarize &amp; Contrast" IsChecked="{Binding ViewModel.BinarizeContrast, Mode=TwoWay}" FontSize="11"/>
                                <CheckBox Grid.Row="1" Content="Table Detection" IsChecked="{Binding ViewModel.TableExtractionMode, Mode=TwoWay}" FontSize="11"/>
                                <CheckBox Grid.Row="1" Grid.Column="1" Content="LaTeX Math Mode" IsChecked="{Binding ViewModel.LatexMathMode, Mode=TwoWay}" FontSize="11"/>
                            </Grid>

                            <!-- Speech Synthesizer Rate Slider -->
                            <Slider Header="Read-Aloud Speech Rate" Minimum="0.5" Maximum="2.0" StepFrequency="0.1"
                                    Value="{Binding ViewModel.SpeechRate, Mode=TwoWay}"
                                    TickFrequency="0.5" TickPlacement="Outside"/>
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>

            <!-- ── RIGHT: MULTI-VIEW STUDY & RESEARCH STUDIO ── -->
            <Border Grid.Column="1" CornerRadius="12" Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- View Navigation Tabs -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tab Selectors -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <RadioButton x:Name="TabBtnEditor" Content="Extracted Editor" IsChecked="True"
                                         Checked="TabSelector_Checked" Tag="0" Style="{StaticResource DefaultToggleButtonStyle}"/>
                            <RadioButton x:Name="TabBtnMarkdown" Content="Markdown View"
                                         Checked="TabSelector_Checked" Tag="1" Style="{StaticResource DefaultToggleButtonStyle}"/>
                            <RadioButton x:Name="TabBtnSynthesizer" Content="AI Study Synthesizer"
                                         Checked="TabSelector_Checked" Tag="2" Style="{StaticResource DefaultToggleButtonStyle}"/>
                            <RadioButton x:Name="TabBtnRagChat" Content="RAG Chat Assistant"
                                         Checked="TabSelector_Checked" Tag="3" Style="{StaticResource DefaultToggleButtonStyle}"/>
                        </StackPanel>

                        <!-- Quick Feedback label -->
                        <TextBlock Grid.Column="1" Text="{Binding ViewModel.LastOperationStatus}"
                                   VerticalAlignment="Center" Foreground="#4CAF50"
                                   FontWeight="SemiBold" FontSize="11.5"/>
                    </Grid>

                    <!-- ══════════════ TAB 0: EXTRACTED TEXT & LIVE EDITOR ══════════════ -->
                    <Grid x:Name="ViewEditor" Grid.Row="1" RowSpacing="8" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Formatting Toolbar -->
                        <Border CornerRadius="8" Padding="8,4" Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button Command="{Binding ViewModel.FormatParagraphsCommand}" ToolTipService.ToolTip="Format line wraps into clean paragraphs" Padding="6,4">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE8D2;" FontSize="11"/>
                                            <TextBlock Text="Format Paragraphs" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ViewModel.CleanExtraWhitespaceCommand}" ToolTipService.ToolTip="Remove extra whitespace &amp; blank lines" Padding="6,4">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE75C;" FontSize="11"/>
                                            <TextBlock Text="Clean Whitespace" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ViewModel.ChangeCaseCommand}" CommandParameter="title" ToolTipService.ToolTip="Convert to Title Case" Padding="6,4">
                                        <TextBlock Text="Title Case" FontSize="11"/>
                                    </Button>
                                    <Button Command="{Binding ViewModel.ChangeCaseCommand}" CommandParameter="upper" ToolTipService.ToolTip="Convert to UPPERCASE" Padding="6,4">
                                        <TextBlock Text="UPPER" FontSize="11"/>
                                    </Button>
                                    <Button Command="{Binding ViewModel.ChangeCaseCommand}" CommandParameter="lower" ToolTipService.ToolTip="Convert to lowercase" Padding="6,4">
                                        <TextBlock Text="lower" FontSize="11"/>
                                    </Button>
                                </StackPanel>

                                <Button Grid.Column="1" Command="{Binding ViewModel.CopyToClipboardCommand}" Padding="6,4">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="11"/>
                                        <TextBlock Text="Copy Text" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Main Editor Text Area -->
                        <TextBox Grid.Row="1"
                                 Text="{Binding ViewModel.OcrResultText, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="13"
                                 Background="{ThemeResource LayerFillColorDefaultBrush}"
                                 CornerRadius="8"
                                 Padding="12"
                                 PlaceholderText="Extracted document text, markdown formatting, or dictated voice notes appear here…"/>
                    </Grid>

                    <!-- ══════════════ TAB 1: MARKDOWN & FORMATTED PREVIEW ══════════════ -->
                    <Grid x:Name="ViewMarkdown" Grid.Row="1" RowSpacing="8" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border CornerRadius="8" Padding="8,4" Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Structured Markdown Document Representation"
                                           FontSize="11.5" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Command="{Binding ViewModel.ExportMarkdownCommand}" Padding="6,4">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE70F;" FontSize="11"/>
                                            <TextBlock Text="Save .md File" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBox Grid.Row="1"
                                 Text="{Binding ViewModel.MarkdownText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="12.5"
                                 Background="{ThemeResource LayerFillColorDefaultBrush}"
                                 CornerRadius="8"
                                 Padding="12"/>
                    </Grid>

                    <!-- ══════════════ TAB 2: AI STUDY SYNTHESIZER ══════════════ -->
                    <ScrollViewer x:Name="ViewSynthesizer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Spacing="12">
                            <!-- AI Actions Header Card -->
                            <Border CornerRadius="10" Padding="14"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="AI Study Synthesizer &amp; Knowledge Extractor" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="100% on-device neural synthesis — extract core thesis, key definitions, and practice questions."
                                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Button Command="{Binding ViewModel.GenerateSummaryCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE70F;" FontSize="11"/>
                                                <TextBlock Text="Summary" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ViewModel.ExtractKeyConceptsCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE735;" FontSize="11"/>
                                                <TextBlock Text="Key Concepts" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ViewModel.GenerateStudyQuizCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE82D;" FontSize="11"/>
                                                <TextBlock Text="Practice Quiz" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Executive Summary Card -->
                            <Border CornerRadius="10" Padding="14"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    Visibility="{Binding ViewModel.HasGeneratedSummary, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Executive Summary" FontWeight="SemiBold" FontSize="12.5"/>
                                    <TextBox Text="{Binding ViewModel.ExecutiveSummary, Mode=OneWay}"
                                             IsReadOnly="True" TextWrapping="Wrap"
                                             Background="Transparent" BorderThickness="0"
                                             FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <!-- Extracted Concepts List -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Extracted Key Concepts &amp; Terminology" FontWeight="SemiBold" FontSize="12.5"/>
                                <ItemsControl ItemsSource="{Binding ViewModel.ExtractedConcepts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:StudyConceptItem">
                                            <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,6"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border CornerRadius="4" Padding="6,2" Background="#1A5B7DE8" VerticalAlignment="Top">
                                                        <TextBlock Text="{x:Bind Term}" FontWeight="SemiBold" FontSize="11"
                                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Definition}"
                                                               FontSize="11.5" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Practice Quiz Section -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Practice Retention Quiz" FontWeight="SemiBold" FontSize="12.5"/>
                                <ItemsControl ItemsSource="{Binding ViewModel.PracticeQuizQuestions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:StudyQuestionItem">
                                            <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,6"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                <StackPanel Spacing="6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{x:Bind Question}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                                        <Button Grid.Column="1" Content="Reveal Answer"
                                                                Command="{Binding DataContext.ViewModel.ToggleQuizAnswerCommand, ElementName=PageRoot}"
                                                                CommandParameter="{Binding}"
                                                                FontSize="10.5" Padding="6,2"/>
                                                    </Grid>
                                                    <Border CornerRadius="6" Padding="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            Visibility="{x:Bind IsAnswerVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="{x:Bind Answer}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ══════════════ TAB 3: OFFLINE DOCUMENT RAG CHAT ASSISTANT ══════════════ -->
                    <Grid x:Name="ViewRagChat" Grid.Row="1" RowSpacing="10" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Quick Prompt Suggestion Chips -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Command="{Binding ViewModel.AskQuickPromptCommand}" CommandParameter="Summarize the core thesis and main findings."
                                        Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="16" Padding="10,4">
                                    <TextBlock Text="📌 Summarize Thesis" FontSize="11"/>
                                </Button>
                                <Button Command="{Binding ViewModel.AskQuickPromptCommand}" CommandParameter="What are the primary methodologies and empirical results?"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="16" Padding="10,4">
                                    <TextBlock Text="🔬 Methodology &amp; Data" FontSize="11"/>
                                </Button>
                                <Button Command="{Binding ViewModel.AskQuickPromptCommand}" CommandParameter="What are the main conclusions and future directions?"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="16" Padding="10,4">
                                    <TextBlock Text="🏁 Key Conclusions" FontSize="11"/>
                                </Button>
                                <Button Command="{Binding ViewModel.AskQuickPromptCommand}" CommandParameter="List the key definitions, terminology, and figures mentioned."
                                        Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="16" Padding="10,4">
                                    <TextBlock Text="🔑 Key Terms" FontSize="11"/>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Conversational Chat Stream -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ViewModel.ChatMessages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ScholarChatMessage">
                                        <Grid Margin="0,0,0,10">
                                            <!-- User Message Bubble (Right aligned) -->
                                            <Border CornerRadius="12,12,2,12" Padding="14,10"
                                                    HorizontalAlignment="Right" MaxWidth="540"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    Visibility="{x:Bind IsUser, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{x:Bind Message}" FontSize="12.5"
                                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{x:Bind FormattedTime}" FontSize="9.5"
                                                               Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Assistant Message Card (Left aligned) -->
                                            <Border CornerRadius="12,12,12,2" Padding="14,10"
                                                    HorizontalAlignment="Left" MaxWidth="620"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                    Visibility="{x:Bind IsUser, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                <StackPanel Spacing="8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE8BD;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                            <TextBlock Text="Scholar AI (Offline RAG)" FontWeight="SemiBold" FontSize="11"/>
                                                            <Border CornerRadius="4" Padding="4,1" Background="#1A4CAF50"
                                                                    Visibility="{x:Bind HasCitations, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="{x:Bind FormattedConfidence}" FontSize="9" FontWeight="Bold" Foreground="#4CAF50"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <Button Grid.Column="1"
                                                                Command="{Binding DataContext.ViewModel.SpeakMessageCommand, ElementName=PageRoot}"
                                                                CommandParameter="{Binding}"
                                                                Padding="4,2" Background="Transparent" BorderThickness="0"
                                                                ToolTipService.ToolTip="Read this response aloud">
                                                            <FontIcon Glyph="&#xE767;" FontSize="12"/>
                                                        </Button>
                                                    </Grid>

                                                    <TextBlock Text="{x:Bind Message}" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>

                                                    <TextBlock Text="{x:Bind FormattedTime}" FontSize="9.5"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Chat Input Box -->
                        <Border Grid.Row="2" CornerRadius="10" Padding="8,6"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ViewModel.ChatQuery, Mode=TwoWay}"
                                         KeyDown="ChatInput_KeyDown"
                                         PlaceholderText="Ask a question about the active document (DirectML + SIMD offline vector search)…"
                                         BorderThickness="0" Background="Transparent" FontSize="12.5"/>
                                <Button Grid.Column="1" Content="Send"
                                        Command="{Binding ViewModel.AskDocumentAiCommand}"
                                        Style="{StaticResource AccentButtonStyle}" FontSize="11.5" Padding="14,6"/>
                            </Grid>
                        </Border>
                    </Grid>

                </Grid>
            </Border>

        </Grid>
    </Grid>
</Page>
