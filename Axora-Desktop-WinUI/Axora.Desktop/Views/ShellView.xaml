<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Axora.Desktop.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootLayoutGrid">
        <!-- Navigation Shell -->
        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            AlwaysShowHeader="True"
            PaneDisplayMode="Left"
            OpenPaneLength="220"
            IsPaneOpen="{Binding ViewModel.IsPaneOpen, Mode=TwoWay}">

            <!-- Page Header (Fluent Task Manager / Windows 11 Design) -->
            <NavigationView.Header>
                <Grid Margin="12,-4,0,2">
                    <TextBlock Text="{Binding ViewModel.CurrentPageTitle, Mode=OneWay}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </Grid>
            </NavigationView.Header>

            <!-- Navigation Items -->
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard"
                                    Tag="Dashboard"
                                    x:Name="NavDashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Scholar Kit"
                                    Tag="ScholarKit"
                                    x:Name="NavScholarKit">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE736;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Resume Studio"
                                    Tag="ResumeStudio"
                                    x:Name="NavResumeStudio">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D7;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator/>

                <NavigationViewItem Content="Batch Image Studio"
                                    Tag="BatchImage"
                                    x:Name="NavBatchImage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB9F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Compressor"
                                    Tag="Compressor"
                                    x:Name="NavCompressor">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Universal Converter"
                                    Tag="UniversalConverter"
                                    x:Name="NavUniversalConverter"
                                    AutomationProperties.Name="Universal Converter"
                                    AutomationProperties.AutomationId="NavUniversalConverter">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8AB;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator/>

                <NavigationViewItem Content="Encrypted Vault"
                                    Tag="Vault"
                                    x:Name="NavVault">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72E;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Flashcard Studio"
                                    Tag="Flashcards"
                                    x:Name="NavFlashcards">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE82D;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator/>

                <NavigationViewItem Content="Mobile Link"
                                    Tag="MobileLink"
                                    x:Name="NavMobileLink">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EA;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Footer: System / Download Manager & Settings -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Download Manager"
                                    Tag="DownloadManager"
                                    x:Name="NavDownloadManager"
                                    AutomationProperties.Name="Download Manager"
                                    AutomationProperties.AutomationId="NavDownloadManager">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings"
                                    Tag="Settings"
                                    x:Name="NavSettings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Content Frame -->
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Global Notification Host -->
        <InfoBar
            x:Name="GlobalNotificationInfoBar"
            AutomationProperties.Name="Global Notification Alert"
            VerticalAlignment="Top"
            HorizontalAlignment="Stretch"
            Margin="24,12,24,0"
            IsOpen="False" />

        <!-- Overlay Container for DropZone and CommandPalette -->
        <Grid x:Name="OverlayContainer" />
    </Grid>
</UserControl>
