<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Axora.Desktop.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="24,6,24,24">
        <StackPanel Spacing="24">

            <!-- System Status Header Badge -->
            <Border CornerRadius="12" Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="14"
                            Background="#1A4CAF50"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#4CAF50"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="System Nominal · All Subsystems Operational"
                                   FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding ViewModel.StatusBadge}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Margin="8,0,0,0"
                             Command="{Binding ViewModel.ShowSystemDiagnosticsCommand}"
                             VerticalAlignment="Center"
                             ToolTipService.ToolTip="View hardware diagnostic report"
                             Style="{StaticResource AccentButtonStyle}">
                         <StackPanel Orientation="Horizontal" Spacing="6">
                             <FontIcon Glyph="&#xEA00;" FontSize="12"/>
                             <TextBlock Text="Diagnostics" VerticalAlignment="Center"/>
                         </StackPanel>
                     </Button>
                    <Button Grid.Column="3"
                            Command="{Binding ViewModel.RefreshTelemetryCommand}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Hardware & Runtime Diagnostic Card (FEAT-7) -->
            <Border Visibility="{Binding ViewModel.IsSystemDiagnosticsOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                    CornerRadius="12" Padding="20,16"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEA00;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Hardware &amp; Runtime Diagnostic Report" FontWeight="SemiBold" FontSize="14"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Command="{Binding ViewModel.CloseSystemDiagnosticsCommand}" Padding="6,4">
                            <FontIcon Glyph="&#xE711;" FontSize="12"/>
                        </Button>
                    </Grid>
                    <TextBox Text="{Binding ViewModel.SystemDiagnosticsText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             FontFamily="Consolas, Cascadia Code, monospace" FontSize="12"
                             Background="Transparent" BorderThickness="0" Padding="0"/>
                </StackPanel>
            </Border>

            <!-- Telemetry Cards -->
            <StackPanel Spacing="12">
                <TextBlock Text="System Overview"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           FontWeight="SemiBold"/>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CPU Card -->
                    <Border Grid.Column="0" CornerRadius="12" Padding="18"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CPU" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <FontIcon Grid.Column="1" Glyph="&#xE950;" FontSize="18"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            </Grid>
                            <TextBlock Text="{Binding ViewModel.FormattedCpu}"
                                       FontSize="28" FontWeight="Bold"/>
                            <ProgressBar Value="{Binding ViewModel.CpuUsagePercent}"
                                         Maximum="100" CornerRadius="4" Height="6"/>
                            <TextBlock Text="DirectML hardware inference"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- RAM Card -->
                    <Border Grid.Column="1" CornerRadius="12" Padding="18"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Memory" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <FontIcon Grid.Column="1" Glyph="&#xE179;" FontSize="18"
                                          Foreground="#7C4DFF"/>
                            </Grid>
                            <TextBlock Text="{Binding ViewModel.Telemetry.RamUsageFormatted}"
                                       FontSize="28" FontWeight="Bold"/>
                            <ProgressBar Value="{Binding ViewModel.Telemetry.RamUsagePercent}"
                                         Maximum="100" CornerRadius="4" Height="6"/>
                            <TextBlock Text="{Binding ViewModel.Telemetry.RamDetailsFormatted}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Storage Card -->
                    <Border Grid.Column="2" CornerRadius="12" Padding="18"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Storage" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <FontIcon Grid.Column="1" Glyph="&#xE8B7;" FontSize="18"
                                          Foreground="#4CAF50"/>
                            </Grid>
                            <TextBlock Text="{Binding ViewModel.Telemetry.StorageUsageFormatted}"
                                       FontSize="28" FontWeight="Bold"/>
                            <ProgressBar Value="{Binding ViewModel.Telemetry.StorageUsagePercent}"
                                         Maximum="100" CornerRadius="4" Height="6"/>
                            <TextBlock Text="{Binding ViewModel.Telemetry.StorageDetailsFormatted}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Connections Card -->
                    <Border Grid.Column="3" CornerRadius="12" Padding="18"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Connections" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <FontIcon Grid.Column="1" Glyph="&#xE8EA;" FontSize="18"
                                          Foreground="#FF9800"/>
                            </Grid>
                            <TextBlock Text="{Binding ViewModel.ActiveConnectionsText}"
                                       FontSize="28" FontWeight="Bold"/>
                            <ProgressBar Value="{Binding ViewModel.ActiveConnectionsCount}" Maximum="5" CornerRadius="4" Height="6"/>
                            <TextBlock Text="{Binding ViewModel.ActiveConnectionsSubtitle}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Recent QuickDrop Activity Feed -->
            <StackPanel Spacing="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Recent Quick Drops &amp; Local Activity"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Command="{Binding ViewModel.OpenQuickDropFolderCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE838;" FontSize="13"/>
                            <TextBlock Text="Open QuickDrop Folder" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        MinHeight="140">
                    <Grid>
                        <!-- Empty State View -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Padding="24"
                                    Visibility="{Binding ViewModel.HasRecentDrops, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <FontIcon Glyph="&#xE8EA;" FontSize="32"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="No Recent Quick Drops"
                                       FontWeight="SemiBold" FontSize="14"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Send files from Axora Mobile or drag &amp; drop files to start local P2P transfers."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>

                        <!-- Populated ListView -->
                        <ListView ItemsSource="{Binding ViewModel.RecentDrops}"
                                  SelectionMode="None"
                                  Padding="8"
                                  Visibility="{Binding ViewModel.HasRecentDrops, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12,10" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="8"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="18"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="{Binding SourceDeviceName}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding FormattedSize}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding FormattedSpeed}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="2" CornerRadius="12" Padding="8,3"
                                                Background="#1A4CAF50" VerticalAlignment="Center">
                                            <TextBlock Text="Completed" FontSize="11" Foreground="#4CAF50" FontWeight="SemiBold"/>
                                        </Border>
                                        <Button Grid.Column="3" Content="Show in Folder"
                                                Click="ShowInFolder_Click" Tag="{Binding}"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
