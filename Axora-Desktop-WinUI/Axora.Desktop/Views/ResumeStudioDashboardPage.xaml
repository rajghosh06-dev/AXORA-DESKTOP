<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Axora.Desktop.Views.ResumeStudioDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24,2,24,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Actions -->
        <Border Grid.Row="0" CornerRadius="12" Padding="16,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Manage, design, and optimize your saved ATS-targeted resume versions."
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <Button x:Name="BtnNewResume"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="NewResume_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="12"/>
                        <TextBlock Text="New Blank Resume" FontSize="12"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">

                <!-- Google Docs-Style Quick Start Templates Gallery -->
                <Border CornerRadius="10" Padding="14,12"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Start a new resume from template" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">

                                <!-- Blank Template -->
                                <Button Width="190" HorizontalContentAlignment="Left"
                                        Padding="10,8" CornerRadius="8"
                                        Click="TemplateBlank_Click" ToolTipService.ToolTip="Create a fresh blank resume">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="34" Height="34" CornerRadius="6"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                                            <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="#111111" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Blank Resume" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="Start from scratch" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>

                                <!-- Tech ATS 2-Page Template -->
                                <Button Width="210" HorizontalContentAlignment="Left"
                                        Padding="10,8" CornerRadius="8"
                                        Click="TemplateRishit_Click" ToolTipService.ToolTip="Load AI/ML &amp; Tech ATS 2-Page template">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="34" Height="34" CornerRadius="6" Background="#264CAF50">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="#4CAF50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Tech ATS (2-Page)" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="AI, ML &amp; Engineering" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>

                                <!-- Software Engineer 1-Page Template -->
                                <Button Width="220" HorizontalContentAlignment="Left"
                                        Padding="10,8" CornerRadius="8"
                                        Click="TemplateSoftware_Click" ToolTipService.ToolTip="Load Compact 1-Page Software Engineer template">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="34" Height="34" CornerRadius="6" Background="#262196F3">
                                            <FontIcon Glyph="&#xE7BE;" FontSize="14" Foreground="#2196F3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Software Eng. (1-Page)" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="Compact high-density" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>

                                <!-- Executive & Leadership 2-Page Template -->
                                <Button Width="230" HorizontalContentAlignment="Left"
                                        Padding="10,8" CornerRadius="8"
                                        Click="TemplateExecutive_Click" ToolTipService.ToolTip="Load Executive &amp; Engineering Leadership 2-Page template">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="34" Height="34" CornerRadius="6" Background="#269C27B0">
                                            <FontIcon Glyph="&#xE77B;" FontSize="14" Foreground="#9C27B0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Executive Leadership" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="VP, Director &amp; Strategy" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>

                                <!-- Academic & Research CV 3-Page Template -->
                                <Button Width="220" HorizontalContentAlignment="Left"
                                        Padding="10,8" CornerRadius="8"
                                        Click="TemplateAcademic_Click" ToolTipService.ToolTip="Load Academic &amp; Research CV 3-Page template">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="34" Height="34" CornerRadius="6" Background="#26FF9800">
                                            <FontIcon Glyph="&#xE736;" FontSize="14" Foreground="#FF9800" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Academic CV (3-Page)" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="Research &amp; Publications" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>

                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Recent Resumes Section Header + Search -->
                <Grid Margin="2,4,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Recent Resumes" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="8,2">
                            <TextBlock x:Name="TxtCount" Text="0" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- Search Box -->
                    <TextBox x:Name="SearchBox" Grid.Column="2" PlaceholderText="Search recent resumes..."
                             Width="220" Padding="8,4" FontSize="11.5" Margin="0,0,8,0"
                             TextChanged="SearchBox_TextChanged"/>

                    <!-- Refresh Button -->
                    <Button Grid.Column="3" Padding="8,4" FontSize="11" ToolTipService.ToolTip="Refresh List"
                            Click="Refresh_Click">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE72C;" FontSize="11"/>
                            <TextBlock Text="Refresh" FontSize="11"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Empty state when 0 resumes saved -->
                <Border x:Name="EmptyState" CornerRadius="10" Padding="32,24"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" Spacing="10">
                        <FontIcon Glyph="&#xE8A5;" FontSize="36"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="No saved resumes found" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Create a new resume from scratch or pick a template above to get started."
                                   FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <Button HorizontalAlignment="Center" Margin="0,6,0,0"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="NewResume_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                <TextBlock Text="Create My First Resume" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Dynamic list of saved resume cards -->
                <StackPanel x:Name="TilesStack" Spacing="8"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
