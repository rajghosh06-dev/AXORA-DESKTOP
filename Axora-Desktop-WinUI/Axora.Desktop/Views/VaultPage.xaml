<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Axora.Desktop.Views.VaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="24,6,24,24">
        <StackPanel MaxWidth="720" HorizontalAlignment="Center" Spacing="20">

            <!-- Security Banner -->
            <Border CornerRadius="12" Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="22"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE72E;" FontSize="20"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="Encrypted Security Vault · Zero-Knowledge Cryptography"
                                   FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="Argon2id Memory Hardening · AES-256-GCM Streaming · TPM 2.0 / DPAPI Hardware Binding"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- File Selection & Batch Queue -->
            <Border CornerRadius="12" Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Target Files &amp; Queue" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Click="BrowseInput_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="12"/>
                                    <TextBlock Text="Add Files" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Content="Clear Queue" Command="{Binding ViewModel.ClearQueueCommand}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Queue List -->
                    <Border CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}"
                            MinHeight="90" MaxHeight="180" Padding="4">
                        <ListView ItemsSource="{Binding ViewModel.Queue}"
                                  SelectionMode="None"
                                  Padding="4">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8A5;" FontSize="16" VerticalAlignment="Center"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding FormattedSize}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <ProgressBar Grid.Column="2" Value="{Binding Progress}" Maximum="100"
                                                     Width="80" Height="4" CornerRadius="2" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Status}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Passphrase & Security Profile & TPM Sealing -->
            <Border CornerRadius="12" Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <PasswordBox Header="Master Vault Passphrase"
                                         PasswordChanged="PasswordBox_PasswordChanged"
                                         x:Name="VaultPasswordBox"
                                         PlaceholderText="Enter passphrase (or unlock with hardware key)…"/>
                            <!-- Real-time Password Strength Bar (FEAT-5) -->
                            <ProgressBar Value="{Binding ViewModel.PasswordStrength}" Maximum="1.0" Minimum="0.0"
                                         Height="4" CornerRadius="2"
                                         Foreground="{Binding ViewModel.PasswordStrength, Converter={StaticResource StrengthToColorBrushConverter}}"
                                         Visibility="{Binding ViewModel.IsPasswordSet, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding ViewModel.PasswordStrength, Converter={StaticResource StrengthToTextConverter}}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11"
                                       Visibility="{Binding ViewModel.IsPasswordSet, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Top" Margin="0,26,0,0"
                                Command="{Binding ViewModel.UnsealHardwareKeyCommand}"
                                ToolTipService.ToolTip="Unlock with TPM 2.0 / DPAPI Hardware Sealed Key">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8D7;" FontSize="12"/>
                                <TextBlock Text="TPM Unlock" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" Header="Argon2id Memory Hardening"
                                  SelectedIndex="{Binding ViewModel.SelectedSecurityProfileIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Standard Profile (64 MB RAM, 3 Passes)"/>
                            <ComboBoxItem Content="High-Security Profile (256 MB RAM, 5 Passes)"/>
                        </ComboBox>

                        <ToggleSwitch Grid.Column="1" Header="Secure Shredding (DoD 5220.22-M)"
                                      IsOn="{Binding ViewModel.ShredOriginalFile, Mode=TwoWay}"
                                      OnContent="Overwrite and Delete" OffContent="Keep Original"/>
                    </Grid>

                    <!-- Hardware Sealing Action Bar -->
                    <Border CornerRadius="8" Padding="12,10"
                            Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="TPM 2.0 Hardware Key Binding" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="Seal master key to this device to prevent decryption if copied to other machines."
                                           Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Content="Seal Key" Command="{Binding ViewModel.SealKeyToMachineCommand}"/>
                                <Button Content="Clear Sealed" Command="{Binding ViewModel.ClearSealedKeyCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Spacing="4">
                        <TextBlock Text="SHA-256 Checksum (Integrity Verification)" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                        <TextBlock Text="{Binding ViewModel.Sha256Checksum}"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Progress & Actions -->
            <StackPanel Spacing="12">
                <ProgressBar Value="{Binding ViewModel.OperationProgress}"
                             Maximum="100" CornerRadius="4" Height="6"/>

                <TextBlock Text="{Binding ViewModel.StatusMessage}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <Button Command="{Binding ViewModel.EncryptBatchCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            MinWidth="150">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72E;" FontSize="14"/>
                            <TextBlock Text="Encrypt Files" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ViewModel.DecryptBatchCommand}"
                            MinWidth="150">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE785;" FontSize="14"/>
                            <TextBlock Text="Decrypt Files" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
