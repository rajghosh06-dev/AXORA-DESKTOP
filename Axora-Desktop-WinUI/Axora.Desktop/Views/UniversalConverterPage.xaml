<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Axora.Desktop.Views.UniversalConverterPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Axora.Desktop.Models"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24,6,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Global Actions -->
        <Border Grid.Row="0" CornerRadius="12" Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                    <TextBlock Text="Local Batch Transformation"
                               FontWeight="SemiBold" FontSize="13"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ViewModel.ProgressStatusText, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Open Output Folder"
                            Command="{Binding ViewModel.OpenOutputFolderCommand}"
                            AutomationProperties.Name="Open Output Folder"
                            AutomationProperties.AutomationId="OpenOutputFolderTopButton"/>

                    <Button Content="Clear Completed"
                            Click="ClearCompleted_Click"
                            Command="{Binding ViewModel.ClearCompletedCommand}"
                            IsEnabled="{Binding ViewModel.HasCompletedItems, Mode=OneWay}"
                            AutomationProperties.Name="Clear Completed"
                            AutomationProperties.AutomationId="ClearCompletedButton"/>

                    <Button Content="Start Conversion"
                            Click="StartConversion_Click"
                            Command="{Binding ViewModel.StartConversionCommand}"
                            IsEnabled="{Binding ViewModel.CanStart, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}"
                            AutomationProperties.Name="Start Conversion"
                            AutomationProperties.AutomationId="StartConversionButton"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main 2-Column Split Workspace -->
        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: File Intake & Transformation Options -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">

                    <!-- Drag & Drop Intake Card -->
                    <Border x:Name="DropZoneBorder"
                            CornerRadius="14" Padding="24"
                            MinHeight="160"
                            BorderThickness="2"
                            BorderBrush="{ThemeResource AccentControlElevationBorderBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            AllowDrop="True"
                            DragOver="DropZone_DragOver"
                            DragLeave="DropZone_DragLeave"
                            Drop="DropZone_Drop">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <FontIcon Glyph="&#xE8AB;" FontSize="36"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Drop Files or Folders Here"
                                       FontWeight="SemiBold" FontSize="14"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Supports PNG, JPG, WebP, BMP, TIFF, PDF, TXT, MD, HTML"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       HorizontalAlignment="Center" Opacity="0.7"/>

                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <Button Click="BrowseFiles_Click"
                                        AutomationProperties.Name="Choose Files"
                                        AutomationProperties.AutomationId="BrowseFilesButton">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8E5;" FontSize="12"/>
                                        <TextBlock Text="Choose Files"/>
                                    </StackPanel>
                                </Button>

                                <Button Click="BrowseFolder_Click"
                                        AutomationProperties.Name="Choose Folder"
                                        AutomationProperties.AutomationId="BrowseFolderButton">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xED25;" FontSize="12"/>
                                        <TextBlock Text="Choose Folder"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Rejected Files Warning InfoBar -->
                    <InfoBar IsOpen="{Binding ViewModel.HasRejectedFiles, Mode=OneWay}"
                             Severity="Warning"
                             Title="Unsupported Files"
                             Message="{Binding ViewModel.RejectedFilesMessage, Mode=OneWay}"
                             IsClosable="True"
                             CloseButtonClick="RejectedInfoBar_CloseButtonClick"
                             AutomationProperties.Name="Unsupported Files Notification"/>

                    <!-- Transformation Options Shelf -->
                    <Border CornerRadius="12" Padding="18"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Conversion Options" FontWeight="SemiBold" FontSize="13"/>

                            <!-- Output Format Selector -->
                            <ComboBox Header="Target Output Format"
                                      ItemsSource="{Binding ViewModel.AvailableTargetFormats}"
                                      SelectedItem="{Binding ViewModel.SelectedTargetFormat, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Target Output Format"
                                      AutomationProperties.AutomationId="TargetFormatComboBox"/>

                            <!-- Collision Policy Selector -->
                            <ComboBox Header="Collision Policy"
                                      SelectedIndex="{Binding ViewModel.SelectedCollisionPolicyIndex, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Collision Policy"
                                      AutomationProperties.AutomationId="CollisionPolicyComboBox">
                                <ComboBoxItem Content="Auto Rename (Append number index)"/>
                                <ComboBoxItem Content="Overwrite (Replace existing destination)"/>
                                <ComboBoxItem Content="Skip (Do not convert existing files)"/>
                            </ComboBox>

                            <!-- Destination Directory Mode -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Output Location" Style="{StaticResource CaptionTextBlockStyle}"/>
                                <RadioButton Content="Save in same folder as source"
                                             IsChecked="{Binding ViewModel.UseSourceDirectory, Mode=TwoWay}"
                                             GroupName="DestLocationGroup"
                                             AutomationProperties.Name="Save in same folder as source"
                                             AutomationProperties.AutomationId="SaveInSameFolderRadioButton"/>
                                <RadioButton Content="Save in custom destination"
                                             GroupName="DestLocationGroup"
                                             AutomationProperties.Name="Save in custom destination"
                                             AutomationProperties.AutomationId="SaveInCustomFolderRadioButton"/>

                                <TextBlock Text="{Binding ViewModel.EffectiveOutputDirectory, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="4,2,0,2"/>

                                <Button Content="Choose Destination Folder…"
                                        Click="ChangeOutputFolder_Click"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Choose Destination Folder"
                                        AutomationProperties.AutomationId="ChangeOutputFolderButton"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Optimization & Quality Presets Shelf -->
                    <Border CornerRadius="12" Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Optimization &amp; Quality" FontWeight="SemiBold" FontSize="13"/>

                            <!-- Format Capability Status Card -->
                            <Border CornerRadius="8" Padding="12,8"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    AutomationProperties.Name="Format Optimization Capabilities"
                                    AutomationProperties.AutomationId="FormatCapabilityCard">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{Binding ViewModel.CurrentFormatCapabilities.FormatDisplayName, Mode=OneWay}"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   AutomationProperties.AutomationId="FormatDisplayNameTextBlock"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ViewModel.FormatSummaryNote, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="WrapWholeWords"
                                               AutomationProperties.AutomationId="FormatCapabilitySummaryTextBlock"/>
                                </StackPanel>
                            </Border>

                            <!-- Preset Selector -->
                            <ComboBox Header="Optimization Preset"
                                      ItemsSource="{Binding ViewModel.AvailablePresets}"
                                      SelectedItem="{Binding ViewModel.SelectedPreset, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Optimization Preset"
                                      AutomationProperties.AutomationId="PresetSelectorComboBox"/>

                            <!-- Preset Description -->
                            <TextBlock Text="{Binding ViewModel.PresetDescriptionText, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="WrapWholeWords"
                                       AutomationProperties.AutomationId="PresetDescriptionTextBlock"/>

                            <!-- Preset Lock Status -->
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE72E;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <TextBlock Text="{Binding ViewModel.PresetLockStatusText, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           AutomationProperties.AutomationId="PresetLockStatusTextBlock"/>
                            </StackPanel>

                            <!-- Effective Summary Grid -->
                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="8" Padding="12,10"
                                    AutomationProperties.Name="Effective Summary"
                                    AutomationProperties.AutomationId="EffectiveSummaryGrid">
                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Quality Summary -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Quality" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding ViewModel.EffectiveQualityDisplay, Mode=OneWay}"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   AutomationProperties.AutomationId="EffectiveQualityTextBlock"/>
                                    </StackPanel>

                                    <!-- Max Dimension Summary -->
                                    <StackPanel Grid.Row="0" Grid.Column="1">
                                        <TextBlock Text="Max Dimension" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding ViewModel.EffectiveMaxDimensionText, Mode=OneWay}"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   AutomationProperties.AutomationId="EffectiveDimensionTextBlock"/>
                                    </StackPanel>

                                    <!-- Target DPI Summary -->
                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                        <TextBlock Text="Target DPI" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding ViewModel.EffectiveTargetDpiText, Mode=OneWay}"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   AutomationProperties.AutomationId="EffectiveDpiTextBlock"/>
                                    </StackPanel>

                                    <!-- Metadata Summary -->
                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBlock Text="Metadata" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding ViewModel.EffectiveMetadataText, Mode=OneWay}"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   AutomationProperties.AutomationId="EffectiveMetadataTextBlock"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Custom Parameters Panel (Unlocked when Custom preset is selected) -->
                            <StackPanel Spacing="10"
                                        AutomationProperties.Name="Custom Parameters Panel"
                                        AutomationProperties.AutomationId="CustomParametersPanel">
                                <TextBlock Text="Custom Settings" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

                                <!-- Quality Slider & Number -->
                                <StackPanel Spacing="4">
                                    <Grid>
                                        <TextBlock Text="Quality" Style="{StaticResource CaptionTextBlockStyle}"/>
                                        <TextBlock Text="{Binding ViewModel.CustomQualityText, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   AutomationProperties.AutomationId="CustomQualityTextBlock"/>
                                    </Grid>
                                    <Slider Minimum="1" Maximum="100"
                                            Value="{Binding ViewModel.CustomQuality, Mode=TwoWay}"
                                            IsEnabled="{Binding ViewModel.IsQualityControlEnabled, Mode=OneWay}"
                                            StepFrequency="1"
                                            AutomationProperties.Name="Quality Slider"
                                            AutomationProperties.AutomationId="QualitySlider"/>
                                    <TextBlock Text="{Binding ViewModel.QualityApplicabilityText, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="WrapWholeWords"
                                               AutomationProperties.AutomationId="QualityApplicabilityHintTextBlock"/>
                                </StackPanel>

                                <!-- Max Dimension ComboBox -->
                                <StackPanel Spacing="4">
                                    <ComboBox Header="Max Dimension"
                                              ItemsSource="{Binding ViewModel.AvailableDimensionOptions}"
                                              SelectedItem="{Binding ViewModel.SelectedDimensionOption, Mode=TwoWay}"
                                              IsEnabled="{Binding ViewModel.IsDimensionControlEnabled, Mode=OneWay}"
                                              DisplayMemberPath="DisplayName"
                                              HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="Max Dimension"
                                              AutomationProperties.AutomationId="MaxDimensionComboBox"/>
                                    <TextBlock Text="{Binding ViewModel.DimensionExplanationText, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="WrapWholeWords"
                                               AutomationProperties.AutomationId="DimensionExplanationTextBlock"/>
                                </StackPanel>

                                <!-- Target DPI ComboBox -->
                                <StackPanel Spacing="4">
                                    <ComboBox Header="Target DPI"
                                              ItemsSource="{Binding ViewModel.AvailableDpiOptions}"
                                              SelectedItem="{Binding ViewModel.SelectedDpiOption, Mode=TwoWay}"
                                              IsEnabled="{Binding ViewModel.IsDpiControlEnabled, Mode=OneWay}"
                                              DisplayMemberPath="DisplayName"
                                              HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="Target DPI"
                                              AutomationProperties.AutomationId="TargetDpiComboBox"/>
                                    <TextBlock Text="{Binding ViewModel.DpiExplanationText, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="WrapWholeWords"
                                               AutomationProperties.AutomationId="DpiExplanationTextBlock"/>
                                </StackPanel>

                                <!-- Metadata Handling Toggle (Preserves exact AutomationProperties.AutomationId="MetadataHandlingToggle") -->
                                <StackPanel Spacing="4">
                                    <ToggleSwitch Header="Metadata Handling"
                                                  IsOn="{Binding ViewModel.StripMetadata, Mode=TwoWay}"
                                                  IsEnabled="{Binding ViewModel.IsMetadataControlEnabled, Mode=OneWay}"
                                                  OnContent="Strip (Privacy Mode)"
                                                  OffContent="Preserve Supported Properties"
                                                  AutomationProperties.Name="Metadata Handling Toggle"
                                                  AutomationProperties.AutomationId="MetadataHandlingToggle"/>
                                    <TextBlock Text="{Binding ViewModel.MetadataExplanationText, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="WrapWholeWords"
                                               AutomationProperties.AutomationId="MetadataExplanationTextBlock"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Format-Aware Optimization Guidance Expander -->
                            <Expander Header="Format &amp; Quality Guidance"
                                      HorizontalAlignment="Stretch"
                                      IsExpanded="False"
                                      AutomationProperties.Name="Format and Quality Guidance"
                                      AutomationProperties.AutomationId="OptimizationGuidanceExpander">
                                <StackPanel Spacing="6" Padding="4">
                                    <TextBlock Text="• JPEG: Quality slider controls lossy DCT compression (1–100)."
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <TextBlock Text="• WebP: Quality parameter supported; Q=100 engages lossless compression."
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <TextBlock Text="• PNG, BMP, TIFF: Lossless encoding; quality compression does not apply."
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <TextBlock Text="• DPI Resolution: Target raster DPI embedded in image file metadata."
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <TextBlock Text="• Dimension Limiting: Downscales bounding box proportionally without upscaling."
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <TextBlock Text="• Privacy Stripping: Strips EXIF, XMP, IPTC, and GPS location metadata tags."
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                </StackPanel>
                            </Expander>

                        </StackPanel>
                    </Border>

                    <!-- Supported Capabilities Info Expander -->
                    <Expander Header="Supported Local Conversions"
                              HorizontalAlignment="Stretch"
                              IsExpanded="False">
                        <StackPanel Spacing="8" Padding="4">
                            <TextBlock Text="Supported Formats:" FontWeight="SemiBold" FontSize="12"/>
                            <ItemsControl ItemsSource="{Binding ViewModel.SupportedSourceFormats}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemWidth="80"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                CornerRadius="4" Padding="6,3" Margin="2">
                                            <TextBlock Text="{Binding}" FontSize="11" HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="• Images: PNG, JPG, WebP, BMP, TIFF (Hardware WIC)&#x0a;• Documents: TXT, Markdown, HTML, PDF&#x0a;• Rasterization: PDF → PNG, JPG (Windows.Data.Pdf)&#x0a;• All conversions run 100% offline and locally."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>

            <!-- Right: Queue Dashboard & Work Items -->
            <Border Grid.Column="1" CornerRadius="14" Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Progress Header & Queue Controls -->
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,8,0">
                                <TextBlock Text="Queue" FontWeight="SemiBold" FontSize="14"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ViewModel.CurrentJobText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button Content="Pause"
                                        Click="PauseQueue_Click"
                                        Command="{Binding ViewModel.PauseQueueCommand}"
                                        Visibility="{Binding ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        IsEnabled="{Binding ViewModel.IsPaused, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        AutomationProperties.Name="Pause Queue"
                                        AutomationProperties.AutomationId="PauseQueueButton"/>

                                <Button Content="Resume"
                                        Click="ResumeQueue_Click"
                                        Command="{Binding ViewModel.ResumeQueueCommand}"
                                        Visibility="{Binding ViewModel.IsPaused, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        AutomationProperties.Name="Resume Queue"
                                        AutomationProperties.AutomationId="ResumeQueueButton"/>

                                <Button Content="Cancel All"
                                        Click="CancelAll_Click"
                                        Command="{Binding ViewModel.CancelAllCommand}"
                                        IsEnabled="{Binding ViewModel.HasItems, Mode=OneWay}"
                                        AutomationProperties.Name="Cancel All"
                                        AutomationProperties.AutomationId="CancelAllButton"/>

                                <Button Content="Clear All"
                                        Click="ClearAll_Click"
                                        Command="{Binding ViewModel.ClearQueueCommand}"
                                        IsEnabled="{Binding ViewModel.HasItems, Mode=OneWay}"
                                        AutomationProperties.Name="Clear All"
                                        AutomationProperties.AutomationId="ClearAllButton"/>
                            </StackPanel>
                        </Grid>

                        <ProgressBar Value="{Binding ViewModel.OverallProgress, Mode=OneWay}"
                                     Maximum="100" CornerRadius="4" Height="6"
                                     AutomationProperties.Name="Conversion Progress Bar"/>

                        <!-- Queue Telemetry Summary Shelf -->
                        <Border CornerRadius="8" Padding="12,8" Margin="0,4,0,0"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Visibility="{Binding ViewModel.HasQueueTelemetry, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                AutomationProperties.Name="Queue Telemetry Summary"
                                AutomationProperties.AutomationId="QueueTelemetrySummaryCard">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Processed Sizes -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Processed" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding ViewModel.QueueOutputVsInputText, Mode=OneWay}"
                                               FontWeight="SemiBold" FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               AutomationProperties.AutomationId="QueueProcessedBytesTextBlock"/>
                                </StackPanel>

                                <!-- Size Delta / Savings -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Size Delta" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding ViewModel.QueueSavingsFormatted, Mode=OneWay}"
                                               FontWeight="SemiBold" FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               AutomationProperties.AutomationId="QueueSavingsTextBlock"/>
                                </StackPanel>

                                <!-- Processing Rate -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Throughput" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding ViewModel.QueueThroughputFormatted, Mode=OneWay}"
                                               FontWeight="SemiBold" FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               AutomationProperties.AutomationId="QueueThroughputTextBlock"/>
                                </StackPanel>

                                <!-- Estimated Remaining Time -->
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Est. Remaining" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding ViewModel.QueueEtaFormatted, Mode=OneWay}"
                                               FontWeight="SemiBold" FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               AutomationProperties.AutomationId="QueueEtaTextBlock"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Queue ListView with Empty State -->
                    <Grid Grid.Row="1">
                        <!-- Empty State Placeholder -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Padding="24"
                                    Visibility="{Binding ViewModel.HasItems, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <FontIcon Glyph="&#xE8AB;" FontSize="40"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="Conversion Queue is Empty"
                                       FontWeight="SemiBold" FontSize="14"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Drop files on the left or click 'Choose Files' to begin local batch transformation."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>

                        <!-- Virtualized Queue List -->
                        <ListView ItemsSource="{Binding ViewModel.Queue}"
                                  SelectionMode="None"
                                  Padding="0"
                                  Visibility="{Binding ViewModel.HasItems, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                  AutomationProperties.Name="Conversion Queue Items List"
                                  AutomationProperties.AutomationId="QueueListView">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ConversionJobUiModel">
                                    <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,8"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Format Icon -->
                                            <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay}"
                                                      FontSize="22" VerticalAlignment="Center"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

                                            <!-- File Metadata & Target -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Text="{x:Bind FileName, Mode=OneWay}"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{x:Bind SourceFilePath, Mode=OneWay}"/>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind TransformationDisplay, Mode=OneWay}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               FontWeight="Medium"
                                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                    <TextBlock Text="·" Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Text="{x:Bind FormattedSize, Mode=OneWay}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>

                                                <!-- Completed Telemetry Summary -->
                                                <TextBlock Text="{x:Bind TelemetrySummaryText, Mode=OneWay}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{x:Bind HasCompletedTelemetry, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                           AutomationProperties.AutomationId="JobTelemetrySummaryTextBlock"/>

                                                <!-- Error Details Block -->
                                                <TextBlock Text="{x:Bind ErrorMessage, Mode=OneWay}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{x:Bind HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </StackPanel>

                                            <!-- Progress or Output Size -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                                <ProgressBar Value="{x:Bind Progress, Mode=OneWay}"
                                                             IsIndeterminate="{x:Bind IsIndeterminateProgress, Mode=OneWay}"
                                                             Maximum="100" CornerRadius="2" Height="4"
                                                             Visibility="{x:Bind CanCancel, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                                <TextBlock Text="{x:Bind FormattedOutputSize, Mode=OneWay}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           HorizontalAlignment="Right"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           Visibility="{x:Bind CanOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                                <TextBlock Text="{x:Bind FormattedElapsedTime, Mode=OneWay}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           HorizontalAlignment="Right"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Visibility="{x:Bind CanOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                           AutomationProperties.AutomationId="JobElapsedTextBlock"/>
                                            </StackPanel>

                                            <!-- Status Label -->
                                            <TextBlock Grid.Column="3"
                                                       Text="{x:Bind HumanStatus, Mode=OneWay}"
                                                       AutomationProperties.Name="{x:Bind HumanStatus, Mode=OneWay}"
                                                       AutomationProperties.AutomationId="ItemStatusTextBlock"
                                                       FontWeight="SemiBold" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                                            <!-- Action Buttons (Cancel / Retry / Open / Remove) -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button Content="Show in Folder"
                                                        Click="OpenFile_Click"
                                                        Tag="{x:Bind OutputFilePath, Mode=OneWay}"
                                                        Visibility="{x:Bind CanOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Padding="8,4" FontSize="11"
                                                        AutomationProperties.Name="Show Output in Folder"
                                                        AutomationProperties.AutomationId="ItemShowInFolderButton"/>

                                                <Button Content="Retry"
                                                        Click="RetryItem_Click"
                                                        Tag="{x:Bind}"
                                                        Visibility="{x:Bind CanRetry, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Padding="8,4" FontSize="11"
                                                        AutomationProperties.Name="Retry Conversion"
                                                        AutomationProperties.AutomationId="ItemRetryButton"/>

                                                <Button Content="Cancel"
                                                        Click="CancelItem_Click"
                                                        Tag="{x:Bind JobId, Mode=OneWay}"
                                                        Visibility="{x:Bind CanCancel, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Padding="8,4" FontSize="11"
                                                        AutomationProperties.Name="Cancel Conversion"
                                                        AutomationProperties.AutomationId="ItemCancelButton"/>

                                                <Button Click="RemoveItem_Click"
                                                        Tag="{x:Bind}"
                                                        Visibility="{x:Bind CanCancel, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                        Style="{StaticResource SubtleButtonStyle}"
                                                        Padding="6"
                                                        AutomationProperties.Name="Remove Item from Queue"
                                                        AutomationProperties.AutomationId="ItemRemoveButton">
                                                    <FontIcon Glyph="&#xE711;" FontSize="12"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Page>
