<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Axora.Desktop.Views.FlashcardsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24,6,24,24" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Decks Management & Retention Stats -->
        <Border Grid.Column="0" CornerRadius="12" Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="Study Decks" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="Spaced Repetition (SM-2)" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                </StackPanel>

                <!-- Deck List -->
                <ListView Grid.Row="1"
                          ItemsSource="{Binding ViewModel.Decks}"
                          SelectedItem="{Binding ViewModel.ActiveDeck, Mode=TwoWay}"
                          SelectionChanged="DeckList_SelectionChanged"
                          SelectionMode="Single"
                          Padding="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="10,8" Margin="0,3"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="2" Background="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run Text="{Binding CardCount}"/>
                                            <Run Text=" cards · "/>
                                            <Run Text="{Binding RetentionRate}"/>
                                            <Run Text="%"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="2" Spacing="8">
                    <Button Content="+ Create New Deck"
                            Command="{Binding ViewModel.CreateDeckCommand}"
                            HorizontalAlignment="Stretch"/>
                    <DropDownButton Content="Export Active Deck" HorizontalAlignment="Stretch">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="Export to CSV (*.csv)"
                                                Command="{Binding ViewModel.ExportDeckToCsvCommand}"/>
                                <MenuFlyoutItem Text="Export for Anki (*.txt)"
                                                Command="{Binding ViewModel.ExportDeckToAnkiTxtCommand}"/>
                                <MenuFlyoutItem Text="Export to JSON (*.json)"
                                                Command="{Binding ViewModel.ExportDeckToJsonCommand}"/>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <TextBlock Text="{Binding ViewModel.ExportStatus}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="#4CAF50" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right: Active Study Canvas & Recall Controls -->
        <Grid Grid.Column="1" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Header & Progress -->
            <Border Grid.Row="0" CornerRadius="12" Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding ViewModel.ActiveDeck.Title}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{Binding ViewModel.DeckStats}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Margin="0,0,12,0"
                            Command="{Binding ViewModel.SpeakCurrentCardCommand}"
                            ToolTipService.ToolTip="Listen to Neural Audio Pronunciation">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE767;" FontSize="13"/>
                            <TextBlock Text="Pronounce" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="2"
                               Text="{Binding ViewModel.SessionProgress}"
                               FontWeight="Bold" FontSize="14"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Interactive Flashcard (Tap to Flip) -->
            <Border Grid.Row="1"
                    CornerRadius="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Tapped="Card_Tapped"
                    MinHeight="320">
                <Grid Padding="48">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="18">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Border CornerRadius="12" Padding="10,4"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <TextBlock x:Name="CardLabelText"
                                           Text="Question / Concept"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            </Border>
                            <Button Padding="6,4" Background="Transparent" BorderThickness="0"
                                    Command="{Binding ViewModel.SpeakCurrentCardCommand}">
                                <FontIcon Glyph="&#xE767;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="Select a deck to begin"
                                   x:Name="CardBodyText"
                                   FontSize="20" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="520"/>

                        <TextBlock Text="Click or Press Space to Flip"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   Opacity="0.5"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Active Recall Rating Buttons (SM-2 Algorithm) -->
            <Border Grid.Row="2" CornerRadius="12" Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="← Previous" Command="{Binding ViewModel.PreviousCardCommand}"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <TextBlock Text="Rate Recall:" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                        <Button Content="Hard (+1d)" Click="Rate_Click" Tag="Hard" Foreground="#E53935"/>
                        <Button Content="Medium (+3d)" Click="Rate_Click" Tag="Medium"/>
                        <Button Content="Easy (+6d)" Click="Rate_Click" Tag="Easy" Foreground="#4CAF50" FontWeight="SemiBold"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="Next →" Command="{Binding ViewModel.NextCardCommand}"/>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Page>
