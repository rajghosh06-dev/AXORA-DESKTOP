<Page
    x:Class="Axora.Desktop.Views.ResumeStudioPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Axora.Desktop.Converters"
    KeyDown="Page_KeyDown">

    <Page.Resources>
        <converters:BoolToVisibilityConverter        x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:ScoreToColorBrushConverter       x:Key="ScoreToColorBrushConverter"/>
        <converters:BudgetToColorBrushConverter      x:Key="BudgetToColorBrushConverter"/>

        <!--
            SegmentRadioButtonStyle
            Custom template for RadioButtons used as segmented tabs and page target toggles.
            Checked   → Gold background (#FFD700), Dark foreground (#111111)
            Unchecked → Dark background (#26262A), Light foreground (#DCDCDC)
        -->
        <Style x:Key="SegmentRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="MinHeight"  Value="0"/>
            <Setter Property="MinWidth"   Value="0"/>
            <Setter Property="Padding"    Value="10,5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="#26262A"
                                BorderBrush="#3D3D42"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="CP"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Foreground="#DCDCDC"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.85"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.65"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.38"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background"  Value="#26262A"/>
                                            <Setter Target="Root.BorderBrush" Value="#3D3D42"/>
                                            <Setter Target="CP.Foreground"    Value="#DCDCDC"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background"  Value="#FFD700"/>
                                            <Setter Target="Root.BorderBrush" Value="#FFB400"/>
                                            <Setter Target="CP.Foreground"    Value="#111111"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="MinHeight"  Value="0"/>
            <Setter Property="MinWidth"   Value="0"/>
            <Setter Property="Padding"    Value="10,5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="#26262A"
                                BorderBrush="#3D3D42"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="CP"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Foreground="#DCDCDC"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.85"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.65"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.38"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background"  Value="#26262A"/>
                                            <Setter Target="Root.BorderBrush" Value="#3D3D42"/>
                                            <Setter Target="CP.Foreground"    Value="#DCDCDC"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background"  Value="#FFD700"/>
                                            <Setter Target="Root.BorderBrush" Value="#FFB400"/>
                                            <Setter Target="CP.Foreground"    Value="#111111"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Padding="16,2,16,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════════
             ROW 0 — GOOGLE DOCS-STYLE EDITABLE RESUME TITLE
             ═══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="2,0,2,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Editable Document Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="6"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8A5;" FontSize="13" Foreground="#111111" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBox x:Name="TxtResumeTitle"
                         Text="{Binding ViewModel.Document.ResumeTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Untitled Resume"
                         FontSize="16" FontWeight="SemiBold"
                         Padding="6,3" MinWidth="220" MaxWidth="380"
                         VerticalAlignment="Center"
                         ToolTipService.ToolTip="Click to rename this resume (stored in your library)"/>
            </StackPanel>

            <!-- Auto-save status indicator -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="Auto-saved to Library" FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════════
             ROW 1 — TOP TOOLBAR
             ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" CornerRadius="12" Padding="10,8,10,12" MinHeight="58"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                <Grid MinWidth="720" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Back to Dashboard + Page Target Dropdown Selector -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button ToolTipService.ToolTip="Back to Resume Library"
                                Padding="8,5" Margin="0,0,4,0"
                                Click="BackToDashboard_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72B;" FontSize="12"/>
                                <TextBlock Text="Library" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Rectangle Width="1" Height="18" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="2,0,4,0"/>

                        <TextBlock Text="Target:" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"/>

                        <ComboBox x:Name="TargetLengthCombo"
                                  FontSize="11.5" Padding="8,4" Width="142"
                                  SelectionChanged="TargetLengthCombo_SelectionChanged"
                                  ToolTipService.ToolTip="Select target page budget length">
                            <ComboBoxItem Content="1-Page Target"/>
                            <ComboBoxItem Content="2-Page Target"/>
                            <ComboBoxItem Content="3-Page Target"/>
                            <ComboBoxItem Content="4+ CV Target"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- CENTER: Spacer with Minimum Separation -->
                    <Border Grid.Column="1" MinWidth="16"/>

                <!-- RIGHT: Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">

                    <!-- Undo / Redo -->
                    <Button x:Name="BtnUndo" ToolTipService.ToolTip="Undo (Ctrl+Z)"
                            Padding="8,5" FontSize="11.5"
                            IsEnabled="{Binding ViewModel.CanUndo}"
                            Click="Undo_Click">
                        <FontIcon Glyph="&#xE7A7;" FontSize="12"/>
                    </Button>
                    <Button x:Name="BtnRedo" ToolTipService.ToolTip="Redo (Ctrl+Y)"
                            Padding="8,5" FontSize="11.5"
                            IsEnabled="{Binding ViewModel.CanRedo}"
                            Click="Redo_Click">
                        <FontIcon Glyph="&#xE7A6;" FontSize="12"/>
                    </Button>

                    <Rectangle Width="1" Height="18" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="2,0"/>

                    <!-- Refresh Preview -->
                    <Button ToolTipService.ToolTip="Refresh Preview" Padding="8,5" FontSize="11.5"
                            Click="RefreshPreview_Click">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                            <TextBlock Text="Refresh" FontSize="11.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="18" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="2,0"/>

                    <!-- Template Picker -->
                    <DropDownButton FontSize="11.5" Padding="8,5" ToolTipService.ToolTip="Load a template preset">
                        <DropDownButton.Content>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE737;" FontSize="12"/>
                                <TextBlock Text="Templates" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DropDownButton.Content>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="Rishit Ghosh — 2-Page ATS Tech"
                                                Click="PresetRishit_Click"/>
                                <MenuFlyoutItem Text="Software Engineer — 1-Page Compact"
                                                Click="PresetSoftware_Click"/>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <Rectangle Width="1" Height="18" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="2,0"/>

                    <!-- Import JSON -->
                    <Button ToolTipService.ToolTip="Import JSON" Padding="8,5" FontSize="11.5"
                            Command="{Binding ViewModel.ImportJsonCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE8B5;" FontSize="12"/>
                            <TextBlock Text="Import" FontSize="11.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Save JSON -->
                    <Button ToolTipService.ToolTip="Save as JSON" Padding="8,5" FontSize="11.5"
                            Click="SaveJson_Click">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE74E;" FontSize="12"/>
                            <TextBlock Text="Save JSON" FontSize="11.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Save to Library -->
                    <Button ToolTipService.ToolTip="Save to Resume Library" Padding="8,5" FontSize="11.5"
                            Click="SaveToLibrary_Click"
                            Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE792;" FontSize="12"/>
                            <TextBlock Text="Save" FontSize="11.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="18" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="2,0"/>

                    <!-- Export PDF split button -->
                    <SplitButton ToolTipService.ToolTip="Export resume" Padding="8,5" FontSize="11.5"
                                 Click="ExportMain_Click">
                        <SplitButton.Content>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xEDE1;" FontSize="12"/>
                                <TextBlock Text="Export Resume" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </SplitButton.Content>
                        <SplitButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="Export as ATS Vector PDF" Click="ExportPdf_Click"/>
                                <MenuFlyoutItem Text="Export as Plain Text (ATS-safe .txt)" Click="ExportTxt_Click"/>
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════
             ROW 2 — 3-PANE WORKSPACE
             ═══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="160" MaxWidth="240"/>
                <ColumnDefinition Width="*" MinWidth="260"/>
                <ColumnDefinition Width="380" MinWidth="280" MaxWidth="440"/>
            </Grid.ColumnDefinitions>

            <!-- ────────────────────────────────────────────────────────────
                 COLUMN 0 — SECTION NAVIGATOR (Left Pane)
                 ──────────────────────────────────────────────────────────── -->
            <Border CornerRadius="12" Padding="10,12"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Document Sections" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="2,0,0,6"/>

                        <!-- Summary -->
                        <Grid Padding="6,5" CornerRadius="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8D2;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="Summary" FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,4,0"/>
                            <ToggleSwitch Grid.Column="2" IsOn="{Binding ViewModel.Document.ShowSummary, Mode=TwoWay}"
                                          OnContent="" OffContent="" MinWidth="0" Margin="0"/>
                        </Grid>

                        <!-- Education -->
                        <Grid Padding="6,5" CornerRadius="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7BE;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="Education" FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,4,0"/>
                            <ToggleSwitch Grid.Column="2" IsOn="{Binding ViewModel.Document.ShowEducation, Mode=TwoWay}"
                                          OnContent="" OffContent="" MinWidth="0" Margin="0"/>
                        </Grid>

                        <!-- Experience -->
                        <Grid Padding="6,5" CornerRadius="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8F9;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="Experience" FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,4,0"/>
                            <ToggleSwitch Grid.Column="2" IsOn="{Binding ViewModel.Document.ShowExperience, Mode=TwoWay}"
                                          OnContent="" OffContent="" MinWidth="0" Margin="0"/>
                        </Grid>

                        <!-- Skills -->
                        <Grid Padding="6,5" CornerRadius="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE943;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="Skills" FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,4,0"/>
                            <ToggleSwitch Grid.Column="2" IsOn="{Binding ViewModel.Document.ShowSkills, Mode=TwoWay}"
                                          OnContent="" OffContent="" MinWidth="0" Margin="0"/>
                        </Grid>

                        <!-- Projects -->
                        <Grid Padding="6,5" CornerRadius="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE754;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="Projects" FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,4,0"/>
                            <ToggleSwitch Grid.Column="2" IsOn="{Binding ViewModel.Document.ShowProjects, Mode=TwoWay}"
                                          OnContent="" OffContent="" MinWidth="0" Margin="0"/>
                        </Grid>

                        <!-- Certifications -->
                        <Grid Padding="6,5" CornerRadius="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE9D5;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="Certifications" FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,4,0"/>
                            <ToggleSwitch Grid.Column="2" IsOn="{Binding ViewModel.Document.ShowCertifications, Mode=TwoWay}"
                                          OnContent="" OffContent="" MinWidth="0" Margin="0"/>
                        </Grid>

                        <!-- Achievements -->
                        <Grid Padding="6,5" CornerRadius="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8D7;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="Achievements" FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,4,0"/>
                            <ToggleSwitch Grid.Column="2" IsOn="{Binding ViewModel.Document.ShowAchievements, Mode=TwoWay}"
                                          OnContent="" OffContent="" MinWidth="0" Margin="0"/>
                        </Grid>

                        <!-- Leadership -->
                        <Grid Padding="6,5" CornerRadius="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE77B;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="Leadership" FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,4,0"/>
                            <ToggleSwitch Grid.Column="2" IsOn="{Binding ViewModel.Document.ShowResponsibilities, Mode=TwoWay}"
                                          OnContent="" OffContent="" MinWidth="0" Margin="0"/>
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,8"/>

                        <!-- Page Budget Gauge -->
                        <TextBlock Text="Page Budget" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="2,0,0,6"/>

                        <ProgressBar Value="{Binding ViewModel.PageBudgetProgressValue}"
                                     Maximum="120" Minimum="0"
                                     Foreground="{Binding ViewModel.PageBudgetProgressValue, Converter={StaticResource BudgetToColorBrushConverter}}"
                                     Height="6" Margin="2,0"/>

                        <TextBlock Text="{Binding ViewModel.PageBudgetStatus}"
                                   FontSize="10" TextWrapping="Wrap" Margin="2,4,2,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,8"/>

                        <!-- Target Description -->
                        <TextBlock Text="{Binding ViewModel.TargetPageLengthDescription}"
                                   FontSize="10" TextWrapping="Wrap" Margin="2,0"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ────────────────────────────────────────────────────────────
                 COLUMN 1 — MULTI-PAGE LIVE PREVIEW (Center Pane)
                 ──────────────────────────────────────────────────────────── -->
            <Border Grid.Column="1" CornerRadius="12" Padding="12"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Preview Bar: badge + label + zoom controls -->
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="5" Padding="6,2" Background="#1A4CAF50" VerticalAlignment="Center">
                            <TextBlock Text="Live ATS Preview" FontSize="11"
                                       Foreground="#4CAF50" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="A4 Vector"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- Zoom Controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                            <Button FontSize="10" Padding="6,2" CornerRadius="4"
                                    Command="{Binding ViewModel.ZoomOutCommand}" ToolTipService.ToolTip="Zoom Out">
                                <FontIcon Glyph="&#xE738;" FontSize="10"/>
                            </Button>
                            <TextBlock Text="{Binding ViewModel.ZoomLabelText}" FontSize="10.5"
                                       VerticalAlignment="Center" MinWidth="32" TextAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Button FontSize="10" Padding="6,2" CornerRadius="4"
                                    Command="{Binding ViewModel.ZoomInCommand}" ToolTipService.ToolTip="Zoom In">
                                <FontIcon Glyph="&#xE710;" FontSize="10"/>
                            </Button>
                            <Button FontSize="10" Padding="6,2" CornerRadius="4"
                                    Command="{Binding ViewModel.ZoomResetCommand}" ToolTipService.ToolTip="Reset Zoom (100%)">
                                <FontIcon Glyph="&#xE72C;" FontSize="10"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Viewbox Preview Area — Scales A4 content to fit available width -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Viewbox Stretch="Uniform" HorizontalAlignment="Center"
                                 MaxWidth="{Binding ViewModel.PreviewMaxWidth}">
                            <StackPanel Width="627" Spacing="20" Margin="0,6,0,24">

                                <!-- ══════════════════════════════════════
                                     PAGE 1 (always visible)
                                     ══════════════════════════════════════ -->
                                <Border Width="595" MinHeight="842"
                                        Background="White" CornerRadius="2"
                                        BorderBrush="#D0D5DD" BorderThickness="1"
                                        Padding="46,34,46,34">
                                    <StackPanel Spacing="0">

                                        <!-- ── Header ── -->
                                        <StackPanel HorizontalAlignment="Center" Spacing="2" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding ViewModel.Document.Header.FullName}"
                                                       FontSize="18" FontWeight="Bold" Foreground="#111111"
