                                </Border>

                                <!-- ══════════════════════════════════════
                                     PAGE 4 (visible in 4+ page mode)
                                     ══════════════════════════════════════ -->
                                <Border Width="595" MinHeight="842"
                                        Visibility="{Binding ViewModel.IsPage4Visible, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="White" CornerRadius="2"
                                        BorderBrush="#D0D5DD" BorderThickness="1"
                                        Padding="46,34,46,34">
                                    <StackPanel Spacing="0">
                                        <!-- Leadership (P4) -->
                                        <StackPanel Spacing="2" Visibility="{Binding ViewModel.LeadershipPage4Vis}" Margin="0,4,0,4">
                                            <TextBlock Text="POSITION OF RESPONSIBILITY" FontSize="10.5" FontWeight="Bold" Foreground="#111111"/>
                                            <Rectangle Height="0.75" Fill="#B0B0B0" Margin="0,1,0,3"/>
                                            <ItemsControl ItemsSource="{Binding ViewModel.Document.Responsibilities}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Spacing="1" Margin="0,2,0,3">
                                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Role}" FontSize="9" FontWeight="Bold" Foreground="#1E1E24"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding DateRange}" FontSize="8.5" Foreground="#555555"/>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Organization}" FontSize="8.5" FontStyle="Italic" Foreground="#444444"/>
                                                            <ItemsControl ItemsSource="{Binding BulletsLines}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                            <TextBlock Text="•" FontSize="9" Foreground="#2A2A2A" Margin="4,0,6,0"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding}" FontSize="9" Foreground="#2A2A2A" TextWrapping="Wrap" LineHeight="13"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <TextBlock HorizontalAlignment="Center" Margin="0,12,0,0" Foreground="#BBBBBB" FontSize="8">
                                            <Run Text="4 of "/><Run Text="{Binding ViewModel.TotalPageCount}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </Viewbox>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ────────────────────────────────────────────────────────────
                 COLUMN 2 — CONTENT EDITOR / STYLE / ATS (Right Pane)
                 ──────────────────────────────────────────────────────────── -->
            <Border Grid.Column="2" CornerRadius="12" Padding="12,10"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tab Selector: Horizontal ScrollViewer with RadioButtons -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                        <Grid MinWidth="320" ColumnSpacing="6" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="TabBtnContent" Grid.Column="0"
                                         GroupName="TabSelectorGroup"
                                         Style="{StaticResource SegmentRadioButtonStyle}"
                                         HorizontalAlignment="Stretch"
                                         MinWidth="95"
                                         Click="TabEditor_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE70F;" FontSize="11.5"/>
                                    <TextBlock Text="Content" FontSize="11.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="TabBtnStyle" Grid.Column="1"
                                         GroupName="TabSelectorGroup"
                                         Style="{StaticResource SegmentRadioButtonStyle}"
                                         HorizontalAlignment="Stretch"
                                         MinWidth="95"
                                         Click="TabFormatting_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE771;" FontSize="11.5"/>
                                    <TextBlock Text="Style" FontSize="11.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="TabBtnAts" Grid.Column="2"
                                         GroupName="TabSelectorGroup"
                                         Style="{StaticResource SegmentRadioButtonStyle}"
                                         HorizontalAlignment="Stretch"
                                         MinWidth="95"
                                         Click="TabAts_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE721;" FontSize="11.5"/>
                                    <TextBlock Text="ATS" FontSize="11.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                    </ScrollViewer>

                    <!-- ══════════ TAB 0: CONTENT EDITOR ══════════ -->
                    <ScrollViewer x:Name="TabEditorScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8">

                            <!-- Header & Contact -->
                            <Expander Header="Header &amp; Contact Info" IsExpanded="True"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="8" Padding="0,8,0,0" HorizontalAlignment="Stretch">
                                    <TextBox Header="Full Name" Text="{Binding ViewModel.Document.Header.FullName, Mode=TwoWay}"/>
                                    <TextBox Header="Professional Title" Text="{Binding ViewModel.Document.Header.ProfessionalTitle, Mode=TwoWay}"/>
                                    <TextBox Header="Location" Text="{Binding ViewModel.Document.Header.Location, Mode=TwoWay}"/>
                                    <TextBox Header="Phone" Text="{Binding ViewModel.Document.Header.Phone, Mode=TwoWay}"/>
                                    <TextBox Header="Email" Text="{Binding ViewModel.Document.Header.Email, Mode=TwoWay}"/>
                                    <TextBox Header="LinkedIn (display)" Text="{Binding ViewModel.Document.Header.LinkedIn, Mode=TwoWay}"/>
                                    <TextBox Header="LinkedIn URL" Text="{Binding ViewModel.Document.Header.LinkedInUrl, Mode=TwoWay}"/>
                                    <TextBox Header="GitHub (display)" Text="{Binding ViewModel.Document.Header.GitHub, Mode=TwoWay}"/>
                                    <TextBox Header="GitHub URL" Text="{Binding ViewModel.Document.Header.GitHubUrl, Mode=TwoWay}"/>
                                    <TextBox Header="Portfolio URL" Text="{Binding ViewModel.Document.Header.PortfolioUrl, Mode=TwoWay}"
                                             PlaceholderText="https://yourportfolio.com (optional)"/>
                                </StackPanel>
                            </Expander>

                            <!-- Professional Summary -->
                            <Expander Header="Professional Summary" IsExpanded="True"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="6" Padding="0,8,0,4" HorizontalAlignment="Stretch">
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Summary Text" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <Button Content="B" FontWeight="Bold" FontSize="11" Padding="7,3" Click="FormatBold_Click" ToolTipService.ToolTip="Bold (**text**)"/>
                                            <Button Content="I" FontStyle="Italic" FontSize="11" Padding="7,3" Click="FormatItalic_Click" ToolTipService.ToolTip="Italic (_text_)"/>
                                            <Button Content="U" FontSize="11" Padding="7,3" Click="FormatUnderline_Click" ToolTipService.ToolTip="Underline (__text__)"/>
                                            <Button FontSize="11" Padding="7,3" Click="FormatLink_Click" ToolTipService.ToolTip="Hyperlink ([text](url))">
                                                <FontIcon Glyph="&#xE71B;" FontSize="11"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <TextBox x:Name="SummaryTextBox"
                                             Text="{Binding ViewModel.Document.Summary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="Enter a 3-4 sentence professional overview detailing your engineering expertise, domain specialization, and impact..."
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             HorizontalAlignment="Stretch"
                                             MinHeight="110" MaxHeight="300"/>
                                </StackPanel>
                            </Expander>

                            <!-- Education -->
                            <Expander Header="Education" IsExpanded="True"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="8" Padding="0,8,0,0" HorizontalAlignment="Stretch">
                                    <ItemsControl ItemsSource="{Binding ViewModel.Document.Education}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Padding="10" Margin="0,0,0,8"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                    <StackPanel Spacing="6">
                                                        <TextBox Header="Institution" Text="{Binding Institution, Mode=TwoWay}"/>
                                                        <TextBox Header="Degree" Text="{Binding Degree, Mode=TwoWay}"/>
                                                        <TextBox Header="Specialization" Text="{Binding Specialization, Mode=TwoWay}"/>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <TextBox Header="Year Range" Text="{Binding YearRange, Mode=TwoWay}"/>
                                                            <TextBox Grid.Column="1" Header="Score / GPA" Text="{Binding ScoreOrPercentage, Mode=TwoWay}"/>
                                                        </Grid>
                                                        <Button FontSize="11" Foreground="#E53935" Padding="8,4"
                                                                Command="{Binding DataContext.ViewModel.RemoveEducationCommand, ElementName=PageRoot}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#E53935"/>
                                                                <TextBlock Text="Remove Entry" FontSize="11"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="+ Add Education" Command="{Binding ViewModel.AddEducationCommand}"
                                             HorizontalAlignment="Stretch" Padding="0,6"/>
                                </StackPanel>
                            </Expander>

                            <!-- Professional Experience -->
                            <Expander Header="Professional Experience" IsExpanded="True"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="8" Padding="0,8,0,0" HorizontalAlignment="Stretch">
                                    <ItemsControl ItemsSource="{Binding ViewModel.Document.Experiences}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Padding="10" Margin="0,0,0,8"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                    <StackPanel Spacing="6">
                                                        <TextBox Header="Company" Text="{Binding Company, Mode=TwoWay}"/>
                                                        <TextBox Header="Role / Title" Text="{Binding RoleTitle, Mode=TwoWay}"/>
                                                        <TextBox Header="Location" Text="{Binding Location, Mode=TwoWay}"/>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <TextBox Header="Start Date" Text="{Binding StartDate, Mode=TwoWay}"/>
                                                            <TextBox Grid.Column="1" Header="End Date" Text="{Binding EndDate, Mode=TwoWay}" PlaceholderText="Present"/>
                                                        </Grid>
                                                        <TextBox Header="Bullet Points (one per line)"
                                                                 Text="{Binding BulletsRaw, Mode=TwoWay}"
                                                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"
                                                                 PlaceholderText="• Architected the data pipeline...&#x0a;• Reduced latency by 40%..."/>
                                                        <TextBox Header="Project Link" Text="{Binding ProjectLink, Mode=TwoWay}"
                                                                 PlaceholderText="github.com/user/project"/>
                                                        <Button FontSize="11" Foreground="#E53935" Padding="8,4"
                                                                Command="{Binding DataContext.ViewModel.RemoveExperienceCommand, ElementName=PageRoot}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#E53935"/>
                                                                <TextBlock Text="Remove Entry" FontSize="11"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="+ Add Experience" Command="{Binding ViewModel.AddExperienceCommand}"
                                             HorizontalAlignment="Stretch" Padding="0,6"/>
                                </StackPanel>
                            </Expander>

                            <!-- Technical Skills -->
                            <Expander Header="Technical Skills"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="8" Padding="0,8,0,0" HorizontalAlignment="Stretch">
                                    <ItemsControl ItemsSource="{Binding ViewModel.Document.SkillCategories}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Padding="10" Margin="0,0,0,8"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                    <StackPanel Spacing="6">
                                                        <TextBox Header="Category Name" Text="{Binding CategoryName, Mode=TwoWay}"/>
                                                        <TextBox Header="Skills (comma-separated)" Text="{Binding SkillsCsv, Mode=TwoWay}" TextWrapping="Wrap"/>
                                                        <Button FontSize="11" Foreground="#E53935" Padding="8,4"
                                                                Command="{Binding DataContext.ViewModel.RemoveSkillCategoryCommand, ElementName=PageRoot}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#E53935"/>
                                                                <TextBlock Text="Remove Entry" FontSize="11"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="+ Add Skill Category" Command="{Binding ViewModel.AddSkillCategoryCommand}"
                                             HorizontalAlignment="Stretch" Padding="0,6"/>
                                </StackPanel>
                            </Expander>

                            <!-- Key Projects -->
                            <Expander Header="Key Projects"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="8" Padding="0,8,0,0" HorizontalAlignment="Stretch">
                                    <ItemsControl ItemsSource="{Binding ViewModel.Document.Projects}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Padding="10" Margin="0,0,0,8"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                    <StackPanel Spacing="6">
                                                        <TextBox Header="Project Title" Text="{Binding Title, Mode=TwoWay}"/>
                                                        <TextBox Header="Tech Stack" Text="{Binding TechStack, Mode=TwoWay}"/>
                                                        <TextBox Header="Date Range" Text="{Binding DateRange, Mode=TwoWay}"/>
                                                        <TextBox Header="Bullet Points (one per line)"
                                                                 Text="{Binding BulletsRaw, Mode=TwoWay}"
                                                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"/>
                                                        <TextBox Header="GitHub / Repo URL" Text="{Binding RepoUrl, Mode=TwoWay}"/>
                                                        <Button FontSize="11" Foreground="#E53935" Padding="8,4"
                                                                Command="{Binding DataContext.ViewModel.RemoveProjectCommand, ElementName=PageRoot}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#E53935"/>
                                                                <TextBlock Text="Remove Entry" FontSize="11"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="+ Add Project" Command="{Binding ViewModel.AddProjectCommand}"
                                             HorizontalAlignment="Stretch" Padding="0,6"/>
                                </StackPanel>
                            </Expander>

                            <!-- Certifications -->
                            <Expander Header="Certifications &amp; Courses"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="8" Padding="0,8,0,0" HorizontalAlignment="Stretch">
                                    <ItemsControl ItemsSource="{Binding ViewModel.Document.Certifications}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Padding="10" Margin="0,0,0,8"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                    <StackPanel Spacing="6">
                                                        <TextBox Header="Certification Name" Text="{Binding Title, Mode=TwoWay}"/>
                                                        <TextBox Header="Issuing Organization" Text="{Binding Issuer, Mode=TwoWay}"/>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <TextBox Header="Date Awarded" Text="{Binding Date, Mode=TwoWay}"/>
                                                            <TextBox Grid.Column="1" Header="Grade / Score" Text="{Binding GradeOrScore, Mode=TwoWay}"
                                                                     PlaceholderText="e.g. Elite (72%)"/>
                                                        </Grid>
                                                        <TextBox Header="Description" Text="{Binding Description, Mode=TwoWay}" TextWrapping="Wrap" MinHeight="50"/>
                                                        <TextBox Header="Verification URL" Text="{Binding VerificationUrl, Mode=TwoWay}"
                                                                 PlaceholderText="https://certificate-verification-link"/>
                                                        <Button FontSize="11" Foreground="#E53935" Padding="8,4"
                                                                Command="{Binding DataContext.ViewModel.RemoveCertificationCommand, ElementName=PageRoot}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#E53935"/>
                                                                <TextBlock Text="Remove Entry" FontSize="11"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="+ Add Certification" Command="{Binding ViewModel.AddCertificationCommand}"
                                             HorizontalAlignment="Stretch" Padding="0,6"/>
                                </StackPanel>
                            </Expander>

                            <!-- Achievements & Workshops -->
                            <Expander Header="Achievements &amp; Workshops"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="8" Padding="0,8,0,0" HorizontalAlignment="Stretch">
                                    <ItemsControl ItemsSource="{Binding ViewModel.Document.Achievements}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Padding="10" Margin="0,0,0,8"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                    <StackPanel Spacing="6">
                                                        <TextBox Header="Category" Text="{Binding Category, Mode=TwoWay}"
                                                                 PlaceholderText="e.g. Award, Workshop, Competition"/>
                                                        <TextBox Header="Title" Text="{Binding Title, Mode=TwoWay}"/>
                                                        <TextBox Header="Date" Text="{Binding Date, Mode=TwoWay}"/>
                                                        <TextBox Header="Description" Text="{Binding Description, Mode=TwoWay}" TextWrapping="Wrap" MinHeight="50"/>
                                                        <TextBox Header="Achievement Link" Text="{Binding Link, Mode=TwoWay}"
                                                                 PlaceholderText="Optional URL"/>
                                                        <Button FontSize="11" Foreground="#E53935" Padding="8,4"
                                                                Command="{Binding DataContext.ViewModel.RemoveAchievementCommand, ElementName=PageRoot}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#E53935"/>
                                                                <TextBlock Text="Remove Entry" FontSize="11"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="+ Add Achievement" Command="{Binding ViewModel.AddAchievementCommand}"
                                             HorizontalAlignment="Stretch" Padding="0,6"/>
                                </StackPanel>
                            </Expander>

                            <!-- Positions of Responsibility -->
                            <Expander Header="Positions of Responsibility"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="8" Padding="0,8,0,0" HorizontalAlignment="Stretch">
                                    <ItemsControl ItemsSource="{Binding ViewModel.Document.Responsibilities}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Padding="10" Margin="0,0,0,8"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                    <StackPanel Spacing="6">
                                                        <TextBox Header="Role / Position" Text="{Binding Role, Mode=TwoWay}"/>
                                                        <TextBox Header="Organization" Text="{Binding Organization, Mode=TwoWay}"/>
                                                        <TextBox Header="Date Range" Text="{Binding DateRange, Mode=TwoWay}"/>
                                                        <TextBox Header="Bullet Points (one per line)"
                                                                 Text="{Binding BulletsRaw, Mode=TwoWay}"
                                                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
                                                        <Button FontSize="11" Foreground="#E53935" Padding="8,4"
                                                                Command="{Binding DataContext.ViewModel.RemoveResponsibilityCommand, ElementName=PageRoot}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#E53935"/>
                                                                <TextBlock Text="Remove Entry" FontSize="11"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="+ Add Position" Command="{Binding ViewModel.AddResponsibilityCommand}"
                                             HorizontalAlignment="Stretch" Padding="0,6"/>
                                </StackPanel>
                            </Expander>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- ══════════ TAB 1: STYLE &amp; LENGTH ══════════ -->
                    <ScrollViewer x:Name="TabStyleScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Spacing="12">

                            <!-- Target Description -->
                            <Border CornerRadius="8" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Page Target" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ViewModel.TargetPageLengthDescription}"
                                               FontSize="10.5" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Typography Section -->
                            <TextBlock Text="Typography" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <ComboBox Header="Font Family" SelectedIndex="{Binding ViewModel.Document.Formatting.FontFamily, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Segoe UI (Default)"/>
                                <ComboBoxItem Content="Calibri"/>
                                <ComboBoxItem Content="Arial"/>
                                <ComboBoxItem Content="Times New Roman"/>
                                <ComboBoxItem Content="Georgia"/>
                            </ComboBox>

                            <ComboBox Header="Line Spacing Mode" SelectedIndex="{Binding ViewModel.Document.Formatting.SpacingMode, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Compact (–15% line height)"/>
                                <ComboBoxItem Content="Standard (default)"/>
                                <ComboBoxItem Content="Relaxed (+20% line height)"/>
                            </ComboBox>

                            <!-- Document Options -->
                            <TextBlock Text="Document Options" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Show section divider lines" VerticalAlignment="Center" FontSize="12"/>
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding ViewModel.Document.Formatting.ShowDividers, Mode=TwoWay}"
                                              OnContent="" OffContent="" MinWidth="40"/>
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Center-align header block" VerticalAlignment="Center" FontSize="12"/>
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding ViewModel.Document.Formatting.CenterHeader, Mode=TwoWay}"
                                              OnContent="" OffContent="" MinWidth="40"/>
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Uppercase section titles" VerticalAlignment="Center" FontSize="12"/>
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding ViewModel.Document.Formatting.UppercaseSectionTitles, Mode=TwoWay}"
                                              OnContent="" OffContent="" MinWidth="40"/>
                            </Grid>

                            <!-- Margin Slider -->
                            <TextBlock Text="Page Margins" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <Slider Header="Margin Width (inches)"
                                    Value="{Binding ViewModel.Document.Formatting.MarginInches, Mode=TwoWay}"
                                    Minimum="0.40" Maximum="1.00" StepFrequency="0.05"
                                    TickFrequency="0.05" TickPlacement="Outside"/>
                            <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="Current margin: "/>
                                <Run Text="{Binding ViewModel.MarginInchesLabel}"/>
                            </TextBlock>

                            <!-- Export Format -->
                            <TextBlock Text="Export Format" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <RadioButton x:Name="ExportRadioPdf" Content="ATS Vector PDF (.pdf)" GroupName="ExportFmt"
                                         IsChecked="True" Checked="ExportFormatPdf_Checked"/>
                            <RadioButton x:Name="ExportRadioTxt" Content="Plain Text ATS-safe (.txt)" GroupName="ExportFmt"
                                         Checked="ExportFormatTxt_Checked"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ══════════ TAB 2: ATS SCANNER ══════════ -->
                    <ScrollViewer x:Name="TabAtsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Spacing="12">

                            <!-- ATS Match Score Card -->
                            <Border CornerRadius="10" Padding="16,12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="ATS Match Score" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run Text="{Binding ViewModel.AtsResult.TotalKeywordsFound}"/>
                                            <Run Text=" / "/>
                                            <Run Text="{Binding ViewModel.AtsResult.TotalKeywordsTarget}"/>
                                            <Run Text=" keywords matched"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ViewModel.AtsResult.MatchScore}"
                                               FontSize="32" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{Binding ViewModel.AtsResult.MatchScore, Converter={StaticResource ScoreToColorBrushConverter}}"/>
                                </Grid>
                            </Border>

                            <!-- Job Description Input -->
                            <TextBox Header="Paste Target Job Description"
                                     Text="{Binding ViewModel.JobDescriptionInput, Mode=TwoWay}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120"
                                     PlaceholderText="Paste the full job description here to run an ATS keyword match against your resume..."/>

                            <Button HorizontalAlignment="Stretch"
                                    Padding="0,8" FontSize="12" FontWeight="SemiBold"
                                    Command="{Binding ViewModel.RunAtsCheckCommand}"
                                    IsEnabled="{Binding ViewModel.IsNotAnalyzingAts}">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE721;" FontSize="13"/>
                                    <TextBlock Text="Run ATS Keyword Match" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Validation message when no JD pasted -->
                            <InfoBar IsOpen="{Binding ViewModel.ShowAtsValidation, Mode=OneWay}"
                                     Severity="Warning"
                                     Title="Job Description Required"
                                     Message="{Binding ViewModel.AtsValidationMessage}"
                                     IsClosable="True"/>

                            <ProgressRing IsActive="{Binding ViewModel.IsAnalyzingAts}"
                                          HorizontalAlignment="Center"
                                          Visibility="{Binding ViewModel.IsAnalyzingAts, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <!-- Matched Keywords (green chips) -->
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        Visibility="{Binding ViewModel.HasAtsResults, Converter={StaticResource BoolToVisibilityConverter}}">
                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#4CAF50"/>
                                <TextBlock Text="Matched Keywords" FontSize="11" FontWeight="SemiBold" Foreground="#4CAF50" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding ViewModel.AtsResult.MatchedKeywords}"
                                          Visibility="{Binding ViewModel.HasAtsResults, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="20" Padding="8,3" Margin="3,3,0,0"
                                                Background="#1A4CAF50">
                                            <TextBlock Text="{Binding}" FontSize="10" Foreground="#4CAF50"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Missing Keywords (red chips) -->
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        Visibility="{Binding ViewModel.HasAtsResults, Converter={StaticResource BoolToVisibilityConverter}}">
                                <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="#E53935"/>
                                <TextBlock Text="Missing Keywords" FontSize="11" FontWeight="SemiBold" Foreground="#E53935" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding ViewModel.AtsResult.MissingKeywords}"
                                          Visibility="{Binding ViewModel.HasAtsResults, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="20" Padding="8,3" Margin="3,3,0,0"
                                                Background="#1AE53935">
                                            <TextBlock Text="{Binding}" FontSize="10" Foreground="#E53935"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- High-Impact Verbs -->
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        Visibility="{Binding ViewModel.HasAtsResults, Converter={StaticResource BoolToVisibilityConverter}}">
                                <FontIcon Glyph="&#xE735;" FontSize="11"/>
                                <TextBlock Text="Action Verbs Found" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding ViewModel.AtsResult.StrongActionVerbs}"
                                          Visibility="{Binding ViewModel.HasAtsResults, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="20" Padding="8,3" Margin="3,3,0,0" Background="#1AFF9800">
                                            <TextBlock Text="{Binding}" FontSize="10" Foreground="#FF9800"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Recommendations -->
                            <TextBlock Text="Recommendations" FontSize="11" FontWeight="SemiBold"
                                       Visibility="{Binding ViewModel.HasAtsResults, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <ItemsControl ItemsSource="{Binding ViewModel.AtsResult.Recommendations}"
                                          Visibility="{Binding ViewModel.HasAtsResults, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="10,8" Margin="0,4,0,0"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty State -->
                            <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,24"
                                        Visibility="{Binding ViewModel.HasAtsResults, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <FontIcon Glyph="&#xE773;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                          HorizontalAlignment="Center"/>
                                <TextBlock Text="Paste a job description above and run the scan"
                                           HorizontalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Border>

        </Grid>
    </Grid>
</Page>
