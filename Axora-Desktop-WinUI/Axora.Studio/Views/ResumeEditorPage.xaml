<Page x:Class="Axora.Studio.Views.ResumeEditorPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid RowSpacing="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Spacing="6">
   <TextBlock Text="{x:Bind ViewModel.ActiveTitle, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock Text="Structured editor · preferences are saved for later rendering" Opacity="0.75" TextWrapping="Wrap"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Spacing="8">
   <StackPanel Orientation="Horizontal" Spacing="10">
    <Button Content="Back" Command="{x:Bind ViewModel.BackCommand}" AutomationProperties.AutomationId="Resume.Back"/>
    <Button Content="Save" Command="{x:Bind ViewModel.SaveCommand}" IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="Resume.Save"/>
    <Button Content="Save Copy" Command="{x:Bind ViewModel.SaveCopyCommand}" IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}" AutomationProperties.AutomationId="Resume.SaveCopy"/>
    <Button Content="Undo" Command="{x:Bind ViewModel.UndoCommand}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="Resume.Undo"/>
    <ProgressRing IsActive="{x:Bind ViewModel.IsSaving, Mode=OneWay}" Width="24" Height="24"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" Spacing="10">
    <Button Content="New Resume" Command="{x:Bind ViewModel.NewCommand}" AutomationProperties.AutomationId="Resume.New"/>
    <Button Content="Open Resume" Command="{x:Bind ViewModel.BackCommand}" AutomationProperties.AutomationId="Resume.ChooseOpen"/>
    <Button Content="Import Copy" Command="{x:Bind ViewModel.ImportCommand}" AutomationProperties.AutomationId="Resume.Import"/>
    <TextBlock Text="Save Copy makes the new copy active" VerticalAlignment="Center" Opacity="0.75" TextWrapping="Wrap"/>
   </StackPanel>
   <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="Resume.Status"/>
  </StackPanel>
  <ScrollViewer x:Name="EditorScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
   <StackPanel x:Name="EditorSurface" Spacing="14" Padding="0,0,16,24"/>
  </ScrollViewer>
 </Grid>
</Page>
