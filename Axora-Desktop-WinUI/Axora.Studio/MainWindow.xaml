<Window x:Class="Axora.Studio.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <NavigationView x:Name="Navigation" PaneTitle="AXORA Studio" IsSettingsVisible="False"
   IsBackButtonVisible="Collapsed" IsBackEnabled="False" PaneDisplayMode="Auto"
   Header="{x:Bind ViewModel.CurrentLabel, Mode=OneWay}" ItemInvoked="OnItemInvoked"
   MenuItemsSource="{x:Bind ViewModel.Routes, Mode=OneTime}" AutomationProperties.Name="Studio navigation">
   <NavigationView.MenuItemTemplate>
    <DataTemplate>
     <NavigationViewItem Content="{Binding Label}" Tag="{Binding Route}" AutomationProperties.Name="{Binding Label}">
      <NavigationViewItem.Icon><SymbolIcon Symbol="{Binding Icon}" /></NavigationViewItem.Icon>
     </NavigationViewItem>
    </DataTemplate>
   </NavigationView.MenuItemTemplate>
   <Grid Padding="24,8,24,24"><ContentControl x:Name="PageContent" /></Grid>
  </NavigationView>
 </Grid>
</Window>
