<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Let the selected .NET 9 SDK resolve its separate runtime/Windows packs.
         A global RuntimeFrameworkVersion also overrides the Windows targeting pack. -->
    <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <Deterministic>true</Deterministic>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Axora.PdfValidation.Worker</AssemblyName>
    <PdfFoundationBuildRoot>$(MSBuildProjectDirectory)\obj\foundation\$(Configuration)\win-x64\</PdfFoundationBuildRoot>
    <PublishDir>$(PdfFoundationBuildRoot)bundle\</PublishDir>
    <!-- Official PdfPig package commit a7bb35662bbbf405efddad50aedc9bcdcf515afc/LICENSE.
         SHA-256 4C510E162F896EA43B4B1CF1B743641D7C756F1004D0E5EAF0615B28B7DED409.
         Kept inline to respect the exact source-path allowlist; decoded only to generated output. -->
    <PdfPigLicenseBase64></PdfPigLicenseBase64>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PdfPig" Version="[0.1.16]" />
    <Compile Include="..\Shared\PdfValidationProtocol.cs" Link="PdfValidationProtocol.cs" />
  </ItemGroup>
  <UsingTask TaskName="GeneratePdfFoundationManifest" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <PublishDirectory ParameterType="System.String" Required="true" />
      <ManifestPath ParameterType="System.String" Required="true" />
      <PackageRoot ParameterType="System.String" Required="true" />
      <LicenseBase64 ParameterType="System.String" Required="true" />
      <ExpectedFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <RuntimePacks ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.Security.Cryptography" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Using Namespace="System.Globalization" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        try {
          // The SDK chooses packs; a changed SDK cannot silently relabel new runtime bytes.
          var core = RuntimePacks.Where(p => p.GetMetadata("FrameworkName") == "Microsoft.NETCore.App").ToArray();
          var windows = RuntimePacks.Where(p => p.GetMetadata("FrameworkName") == "Microsoft.Windows.SDK.NET.Ref").ToArray();
          if (core.Length != 1 || core[0].GetMetadata("NuGetPackageVersion") != "9.0.20" ||
              windows.Length != 1 || windows[0].GetMetadata("NuGetPackageVersion") != "10.0.26100.57")
            throw new InvalidDataException("Resolved SDK/runtime version requires review");
          var expected = new HashSet<string>(StringComparer.Ordinal);
          var sources = new Dictionary<string, string>(StringComparer.Ordinal);
          foreach (var item in ExpectedFiles) {
            string name = item.GetMetadata("RelativePath");
            if (String.IsNullOrEmpty(name)) name = Path.GetFileName(item.ItemSpec);
            if (!expected.Add(name)) throw new InvalidDataException("Duplicate publish entry");
            sources.Add(name, item.GetMetadata("FullPath"));
          }
          var notes = new Dictionary<string, byte[]>(StringComparer.Ordinal);
          notes.Add("PdfPig-LICENSE.txt", Convert.FromBase64String(LicenseBase64));
          notes.Add("PdfPig-PACKAGE.nuspec", File.ReadAllBytes(Path.Combine(PackageRoot, "pdfpig", "0.1.16", "pdfpig.nuspec")));
          notes.Add("DotNet-LICENSE.txt", File.ReadAllBytes(Path.Combine(PackageRoot, "microsoft.netcore.app.runtime.win-x64", "9.0.20", "LICENSE.TXT")));
          notes.Add("DotNet-THIRD-PARTY-NOTICES.txt", File.ReadAllBytes(Path.Combine(PackageRoot, "microsoft.netcore.app.runtime.win-x64", "9.0.20", "THIRD-PARTY-NOTICES.TXT")));
          notes.Add("WindowsSdk-PACKAGE.nuspec", File.ReadAllBytes(Path.Combine(PackageRoot, "microsoft.windows.sdk.net.ref", "10.0.26100.57", "microsoft.windows.sdk.net.ref.nuspec")));
          foreach (var pair in notes) {
            if (!expected.Add(pair.Key)) throw new InvalidDataException("Notice collision");
            File.WriteAllBytes(Path.Combine(PublishDirectory, pair.Key), pair.Value);
          }
          string[] actual = Directory.GetFileSystemEntries(PublishDirectory);
          if (actual.Length < 1 || actual.Length > 512 || !expected.SetEquals(actual.Select(Path.GetFileName))) throw new InvalidDataException("Unexpected publish file set");
          var names = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
          var rows = new List<string>(); long total = 0;
          foreach (string path in actual.OrderBy(Path.GetFileName, StringComparer.Ordinal)) {
            string name = Path.GetFileName(path);
            if (!Regex.IsMatch(name, @"\A[A-Za-z0-9][A-Za-z0-9._-]{0,127}\z") || name.EndsWith(".", StringComparison.Ordinal) ||
                Regex.IsMatch(name.Split('.')[0], @"\A(CON|PRN|AUX|NUL|COM[0-9]|LPT[0-9])\z", RegexOptions.IgnoreCase) ||
                !names.Add(name) || (File.GetAttributes(path) & (FileAttributes.Directory | FileAttributes.ReparsePoint)) != 0) throw new InvalidDataException("Unsafe publish entry");
            using (var file = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.Read))
            using (var hash = SHA256.Create()) {
              long length = file.Length; total = checked(total + length);
              string digest = BitConverter.ToString(hash.ComputeHash(file)).Replace("-", "");
              if (sources.ContainsKey(name)) {
                using (var source = new FileStream(sources[name], FileMode.Open, FileAccess.Read, FileShare.Read)) {
                  if (source.Length != length || BitConverter.ToString(hash.ComputeHash(source)).Replace("-", "") != digest)
                    throw new InvalidDataException("Publish bytes differ from resolved build input");
                }
              }
              rows.Add("{\"name\":\"" + name + "\",\"bytes\":" + length.ToString(CultureInfo.InvariantCulture) + ",\"sha256\":\"" + digest + "\"}");
            }
          }
          if (total > 256L * 1024 * 1024 || !expected.Contains("Axora.PdfValidation.Worker.exe") || !expected.Contains("Axora.PdfValidation.Worker.dll")) throw new InvalidDataException("Worker bundle limits");
          string manifest = "{\"domain\":\"AXORA.PdfValidation.WorkerBundle\",\"version\":1,\"targetFramework\":\"net9.0-windows10.0.26100.0\",\"runtimeIdentifier\":\"win-x64\",\"runtimeFrameworkVersion\":\"9.0.20\",\"windowsSdkPackageVersion\":\"10.0.26100.57\",\"fileCount\":" + actual.Length.ToString(CultureInfo.InvariantCulture) + ",\"totalBytes\":" + total.ToString(CultureInfo.InvariantCulture) + ",\"files\":[" + String.Join(",", rows) + "]}";
          File.WriteAllText(ManifestPath, manifest, new UTF8Encoding(false));
        } catch (Exception ex) { Log.LogError("PdfFoundationManifest: " + ex.Message); return false; }
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="RequirePdfFoundationOutputShape" BeforeTargets="PrepareForBuild;PrepareForPublish">
    <Error Condition="'$(Configuration)' != 'Debug' and '$(Configuration)' != 'Release'" Text="Unsupported PdfValidation build configuration." />
    <Error Condition="'$(TargetFramework)' != 'net9.0-windows10.0.26100.0' or '$(RuntimeIdentifier)' != 'win-x64' or '$(PlatformTarget)' != 'x64' or '$(SelfContained)' != 'true' or '$(PublishSingleFile)' != 'false' or '$(PublishTrimmed)' != 'false' or '$(PublishAot)' != 'false'"
      Text="PdfValidation requires the fixed Windows x64 self-contained multi-file build shape." />
    <PropertyGroup>
      <_PdfExpectedRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\obj\foundation\$(Configuration)\win-x64\'))</_PdfExpectedRoot>
      <_PdfActualRoot>$([System.IO.Path]::GetFullPath('$(PdfFoundationBuildRoot)'))</_PdfActualRoot>
      <_PdfExpectedPublish>$([System.IO.Path]::GetFullPath('$(_PdfExpectedRoot)bundle\'))</_PdfExpectedPublish>
      <_PdfActualPublish>$([System.IO.Path]::GetFullPath('$(PublishDir)'))</_PdfActualPublish>
    </PropertyGroup>
    <Error Condition="'$(_PdfActualRoot)' != '$(_PdfExpectedRoot)' or '$(_PdfActualPublish)' != '$(_PdfExpectedPublish)'" Text="PdfValidation output must stay in its fixed generated project directory." />
  </Target>
  <Target Name="GenerateAuthenticatedPdfFoundationManifest" AfterTargets="Publish">
    <GeneratePdfFoundationManifest PublishDirectory="$(PublishDir)" ManifestPath="$(PdfFoundationBuildRoot)worker-bundle.json"
      PackageRoot="$(NuGetPackageRoot)" LicenseBase64="$(PdfPigLicenseBase64)" ExpectedFiles="@(ResolvedFileToPublish)" RuntimePacks="@(RuntimePack)" />
  </Target>
</Project>
